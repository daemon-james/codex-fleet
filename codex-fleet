      out.push("<blockquote>"+md(buf.join("\n"))+"</blockquote>");continue}
    if(ITEM.test(l)){flush();const r=list(lines,i);out.push(r.html);i=r.next;continue}
    if(/^\s*\|.*\|\s*$/.test(l)&&i+1<lines.length&&/^\s*\|?\s*:?-{2,}/.test(lines[i+1])){
      flush();const r=table(lines,i);out.push(r.html);i=r.next;continue}
