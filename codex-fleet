            f"{meta.get('turns', 0):<6} {render_output_tokens(events, meta):<9} "
            f"{mcp_text(latest_events, meta):<9} {age(latest, meta):<5} "
            f"{msg}{foreign}{worktree}"
        )


def cmd_watch(args):
    meta = load_meta(args.name)
    seen = 0
    idle_since = None
    while True:
        meta = load_meta(args.name)
        path = run_dir(args.name) / f"turn-{meta.get('turns', 1)}.jsonl"
        events = read_events(path)
        for ev in events[seen:]:
            if args.raw:
                print(json.dumps(ev))
            else:
                line = describe(ev, verbose=args.verbose)
                if line is not None:
                    print(line)
        seen = len(events)
        if not alive(meta.get("pid")):
            if idle_since is None:
                idle_since = time.time()
            elif time.time() - idle_since > 1.0:
                err_path = run_dir(args.name) / f"turn-{meta.get('turns', 1)}.err"
                if not events and err_path.exists():
                    sys.stderr.write(err_path.read_text()[:2000])
                break
        else:
            idle_since = None
        time.sleep(0.4)


def cmd_tail(args):
    meta = load_meta(args.name)
    events = all_events(args.name, meta) if args.all else read_events(
        run_dir(args.name) / f"turn-{meta.get('turns', 1)}.jsonl"
    )
    for ev in events[-args.n :]:
        if args.raw:
            print(json.dumps(ev))
        else:
            line = describe(ev, verbose=args.verbose)
            if line is not None:
                print(line)


def warn_if_unwatched(exclude=None):
    """Say so when agents are running and nothing is waiting on them.

    `wait` returns on the FIRST completion, so covering a fan-out means
    re-issuing it every time. That is a workflow that depends on the
    orchestrator remembering, and MAINTAINING.md is explicit that such a
    workflow is not a workflow. On 2026-08-21 the ball was dropped this way
    repeatedly: read a result, report it, end the turn, and the remaining agents
    finished into silence.

    Reading a result is always what precedes that mistake, so this fires there.
    It costs one pgrep and prints nothing when a wait is already up.
    """
    running = [n for n, m in all_runs() if alive(m.get("pid")) and n != exclude]
    if not running:
        return
    try:
        watched = subprocess.run(
            ["pgrep", "-af", r"codex-fleet wait"], capture_output=True, text=True
        ).stdout
    except OSError:
        watched = ""
    # Any live `wait` naming a running run counts as covered.
    if any(name in watched for name in running):
        return
    names = " ".join(sorted(running))
    print(
        paint(
            f"\n  {len(running)} agent(s) running with nothing waiting on them: {names}\n"
            f"  background this or they finish into silence:\n"
            f"    codex-fleet wait {names}",
            "yellow",
        ),
        file=sys.stderr,
    )


def cmd_result(args):
    """The latest turn only, so a failed turn never returns a stale earlier answer."""
    meta = load_meta(args.name)
    # Reading a result is what proves the work was looked at. The Stop hook
    # blocks ending the turn while a finished agent's latest turn is unread.
    if meta and not alive(meta.get("pid")) and meta.get("result_read_turn") != meta.get("turns", 0):
        meta["result_read_turn"] = meta.get("turns", 0)
        save_meta(args.name, meta)
    events = (
        all_events(args.name, meta)
        if args.all
        else read_events(run_dir(args.name) / f"turn-{meta.get('turns', 1)}.jsonl")
    )
    text = last_message(events, args.name)
    if not text:
        st = status_of(args.name, meta)
        err_path = run_dir(args.name) / f"turn-{meta.get('turns', 1)}.err"
        if err_path.exists() and err_path.stat().st_size:
            sys.stderr.write(err_path.read_text()[:2000])
        die(f"{args.name}: no agent message in turn {meta.get('turns')} (status {st})", 2)
    latest = read_events(run_dir(args.name) / f"turn-{meta.get('turns', 1)}.jsonl")
    print(mcp_text(latest, meta))
    print(text)
    warn_if_unwatched(exclude=args.name)


def refresh_worktree(meta):
    """Bring a run's worktree up to the repo's current branch before a resume.

    A worktree is branched at spawn and then never moves. Resume a reviewer
    three commits later and it reads the files it was born with while being
    asked about a commit that is not in them. It reports what it sees, which
    looks like a stale or confused review and is actually correct reporting of
    a tree nobody advanced.

    Hand-merging it works and was done twice on 2026-08-21 before this existed.
    Doing it here means it cannot be forgotten on the third round, which is the
    round where it matters most.

    Merges only. A worktree holding uncommitted work, or one that cannot
    fast-forward cleanly, is left exactly as it is and reported, because
    silently discarding an agent's work to tidy a branch is worse than a stale
    read.
    """
    wt = meta.get("worktree")
    root = meta.get("worktree_root")
    if not wt or not root or not Path(wt).exists():
        return None

    dirty = subprocess.run(
        ["git", "-C", wt, "status", "--porcelain"], capture_output=True, text=True
    )
    if dirty.returncode != 0:
        return None
    if dirty.stdout.strip():
        return "holds uncommitted work, left alone"

    head = subprocess.run(
        ["git", "-C", root, "rev-parse", "--abbrev-ref", "HEAD"],
        capture_output=True, text=True,
    )
    branch = head.stdout.strip()
    if head.returncode != 0 or not branch or branch == "HEAD":
        return None

    before = subprocess.run(
        ["git", "-C", wt, "rev-parse", "--short", "HEAD"], capture_output=True, text=True
    ).stdout.strip()
    merged = subprocess.run(
        ["git", "-C", wt, "-c", "user.name=codex-fleet",
         "-c", "user.email=codex-fleet@localhost",
         "merge", "--no-edit", branch],
        capture_output=True, text=True,
    )
    if merged.returncode != 0:
        subprocess.run(["git", "-C", wt, "merge", "--abort"], capture_output=True)
        return f"could not merge {branch}, left at {before}"
    after = subprocess.run(
        ["git", "-C", wt, "rev-parse", "--short", "HEAD"], capture_output=True, text=True
    ).stdout.strip()
    return None if before == after else f"advanced {before} to {after}"


def cmd_say(args):
    meta = load_meta(args.name)
    if alive(meta.get("pid")):
        die(f"{args.name} is still running — wait, or codex-fleet kill {args.name}", 2)
    if not meta.get("thread_id"):
        die(f"{args.name} has no thread id; cannot resume")
    if args.effort:
        meta["effort"] = resolve_effort(meta.get("role", "engineer"), args.effort)
    note = refresh_worktree(meta)
    if note:
        print(f"  worktree {note}")
    _, events_path = launch(args.name, meta, args.prompt, resume_id=meta["thread_id"])
    print(f"{args.name}: turn {meta['turns']} started (pid {meta['pid']})")
    if args.follow:
        cmd_watch(argparse.Namespace(name=args.name, verbose=args.verbose, raw=False, since=0))


def warn_if_orphaned():
    """Say so when this wait's exit will wake nobody.

    From Claude Code a wait only matters if it runs as a tracked background
    Bash task, which puts a `claude` process in its ancestry. Started with a
    shell `&`, it is reparented to PID 1 when its shell exits, returns on the
    first completion, and nothing is notified. Three dropped threads on
    2026-08-22 had exactly that shape. Orchestration should not use wait at
    all now: use `codex-fleet events` and restart it after monitor timeouts.
    """
    pid = os.getpid()
    seen = 0
    while pid and pid != 1 and seen < 32:
        seen += 1
        try:
            with open(f"/proc/{pid}/stat", encoding="utf-8") as fh:
                stat = fh.read()
            comm = stat[stat.index("(") + 1 : stat.rindex(")")]
            pid = int(stat[stat.rindex(")") + 2 :].split()[1])
        except (OSError, ValueError, IndexError):
            return
        if comm == "claude":
            return
    print(
        paint(
            "  this wait has no claude ancestor, so nothing will be woken when it returns.\n"
            "  From Claude Code, arm the fleet connection instead:\n"
            '  Monitor({ command: "codex-fleet events", description: "codex fleet" })',
            "yellow",
        ),
        file=sys.stderr,
    )


def cmd_wait(args):
    """Return as soon as ANY named run finishes. --all restores the barrier.

    This used to block until every named run finished, and that is the wrong
    default for a fleet. The orchestrator's only reliable wake-up is this
    command exiting, so waiting on a fast agent and a slow one together made the
    fast one's result invisible until the slow one landed. On 2026-08-21 a test
    agent sat finished for several minutes behind a longer-running engineer, and
    the owner noticed before the orchestrator did.

    A finished agent is work to do. Return, report who is still going, and let
    the caller re-wait for the rest.
    """
    names = args.names or [n for n, _ in all_runs()]
    deadline = time.time() + args.timeout if args.timeout else None
    pending = set(names)
    done = []
    warn_if_orphaned()

    def report(name, meta):
        st = status_of(name, meta)
        colour = "red" if st in ("failed", "stopped") else "green"
        print(f"{name}: {paint(st, colour)}")
        if st in ("failed", "stopped"):
            err_path = run_dir(name) / f"turn-{meta.get('turns', 1)}.err"
            if err_path.exists() and err_path.stat().st_size:
                for line in err_path.read_text().strip().splitlines()[:6]:
                    print(paint(f"    {line}", "red"))

    while pending:
        for name in sorted(pending):
            meta = load_meta(name)
            if not alive(meta.get("pid")):
                report(name, meta)
                done.append(name)
                pending.discard(name)
        if done and not args.all:
            if pending:
                print(f"still running: {', '.join(sorted(pending))}")
                print(f"  wait again with: codex-fleet wait {' '.join(sorted(pending))}")
            return
        if pending and deadline and time.time() > deadline:
            print(f"timeout, still running: {', '.join(sorted(pending))}", file=sys.stderr)
            sys.exit(3)
        if pending:
            time.sleep(1.0)


def cmd_tell(args):
    """Push a message into a RUNNING agent's turn.

    `say` cannot do this: `codex exec` reads stdin only for the initial prompt
    and has no channel into a turn already in flight. This writes to the run's
    inbox instead, and the PostToolUse hook hands it to the agent on its next
    tool call. Delivery therefore costs one tool call, not one turn.

    Works whether or not the agent is running. A message left for an idle agent
    is delivered when it next moves.
    """
    meta = load_meta(args.name)
    if not meta:
        die(f"no run named {args.name}")
    d = run_dir(args.name)
    d.mkdir(parents=True, exist_ok=True)
    inbox = d / "inbox.jsonl"
    with open(inbox, "a", encoding="utf-8") as fh:
        fh.write(json.dumps({"text": args.message, "at": now(), "read": False}) + "\n")
    # A reply retires outstanding questions, including non-blocking ones.
    answered = mark_questions_answered(args.name)
    if answered:
        print(f"{args.name}: {answered} question(s) marked answered")
    state = status_of(args.name, meta)
    where = "on its next tool call" if state == "running" else "when it next runs"
    print(f"queued for {args.name} ({state}); delivered {where}")


@contextlib.contextmanager
def outbox_lock(path):
    """Serialize appends with the readers that rewrite the outbox."""
    with path.with_suffix(".lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def cmd_ask(args):
    """Raise a question or a blocker WITHOUT ending your turn. Run by the agent.

    The counterpart to `tell`. An agent that hits a wrong brief, a missing
    decision, or a file another agent has claimed used to have one option: burn
    the rest of the turn, or stop. Now it writes here and keeps working. The
    orchestrator sees it on its next tool call and can answer with `tell`,
    which lands on the agent's next tool call.

    Reads CODEX_FLEET_RUN, so the agent never has to know its own name.
    """
    name = args.name or os.environ.get("CODEX_FLEET_RUN")
    if not name:
        die("no run name: set CODEX_FLEET_RUN, or pass one")
    d = run_dir(name)
    if not d.exists():
        die(f"no run named {name}")
    path = d / "outbox.jsonl"
    with outbox_lock(path):
        with open(path, "a", encoding="utf-8") as fh:
            fh.write(json.dumps({
                "text": args.message,
                "at": now(),
                "blocking": bool(args.blocking),
                "read": False,
                "answered": False,
            }) + "\n")
    if args.blocking:
        print("raised as BLOCKING. Keep working on anything that does not depend "
              "on the answer; check back for a reply on later tool calls.")
    else:
        print("raised. Keep working; a reply will reach you on a later tool call.")


def mark_questions_answered(name):
    """Retire an agent's outstanding questions. Returns how many.

    Called by `tell`, because reaching the agent is the only thing that actually
    answers it. Reading a question does not.
    """
    path = run_dir(name) / "outbox.jsonl"
    try:
        with outbox_lock(path):
            if not path.exists():
                return 0
            lines = [ln for ln in path.read_text(encoding="utf-8").splitlines() if ln.strip()]
            rewritten, count = [], 0
            for ln in lines:
                try:
                    msg = json.loads(ln)
                except ValueError:
                    rewritten.append(ln)
                    continue
                if not msg.get("answered"):
                    msg["answered"] = True
                    msg["read"] = True
                    count += 1
                rewritten.append(json.dumps(msg))
            if count:
                tmp = path.with_suffix(".jsonl.tmp")
                tmp.write_text("\n".join(rewritten) + "\n", encoding="utf-8")
                os.replace(tmp, path)
            return count
    except OSError:
        return 0


def all_questions(name):
    """Every question this agent has raised, blocking or not, oldest first."""
    path = run_dir(name) / "outbox.jsonl"
    if not path.exists():
        return []
    out = []
    try:
        for ln in path.read_text(encoding="utf-8").splitlines():
            if not ln.strip():
                continue
            try:
                out.append(json.loads(ln))
            except ValueError:
                continue
    except OSError:
        return []
    # Older tell versions marked only blocking questions. The retained inbox
    # proves which earlier questions already received a reply, even after read.
    replied_at = max((m.get("at", "") for m in read_events(run_dir(name) / "inbox.jsonl")), default="")
    for msg in out:
        if "answered" not in msg and msg.get("at") and msg["at"] <= replied_at:
            msg["answered"] = True
    return out


def unanswered_blocking(name):
    """Blocking questions this agent is still waiting on. Read-only."""
    path = run_dir(name) / "outbox.jsonl"
    if not path.exists():
        return []
    out = []
    try:
        for ln in path.read_text(encoding="utf-8").splitlines():
            if not ln.strip():
                continue
            try:
                msg = json.loads(ln)
            except ValueError:
                continue
            if msg.get("blocking") and not msg.get("answered"):
                out.append(msg)
    except OSError:
        return []
    return out


def read_outbox(
    name, mark_read=True, include_unanswered_blocking=False, include_read=False
):
    """Agent questions, oldest first. Used by `inbox` and the orchestrator's hook.

    A NON-blocking question is delivered once: it is informational and repeating
    it is noise.

    A BLOCKING question survives being read. The agent has stopped and is waiting,
    so the only thing that should silence it is an answer. It cost a real
    incident to learn that: the hook polled the outbox, marked a blocking
    question read as a side effect of looking, its own output was lost, and
    `codex-fleet inbox` then printed "nothing raised" while the agent slept in
    30-second polls for twenty minutes. Reading is not answering, and a surface
    that reports "nothing" when it means "I already looked once" is worse than
    one that repeats itself.

    `codex-fleet tell <name>` is what marks them answered, because that is the
    only call that actually reaches the agent.
    """
    path = run_dir(name) / "outbox.jsonl"
    try:
        with outbox_lock(path):
            if not path.exists():
                return []
            lines = [ln for ln in path.read_text(encoding="utf-8").splitlines() if ln.strip()]
            unread, rewritten, changed = [], [], False
            for ln in lines:
                try:
                    msg = json.loads(ln)
                except ValueError:
                    rewritten.append(ln)
                    continue
                blocking_unanswered = msg.get("blocking") and not msg.get("answered")
                if (
                    include_read
                    or (not msg.get("read") and not msg.get("answered"))
                    or (include_unanswered_blocking and blocking_unanswered)
                ):
                    unread.append(msg)
                    if mark_read and not msg.get("read"):
                        msg["read"] = True
                        changed = True
                rewritten.append(json.dumps(msg))
            if changed:
                tmp = path.with_suffix(".jsonl.tmp")
                tmp.write_text("\n".join(rewritten) + "\n", encoding="utf-8")
                os.replace(tmp, path)
            return unread
    except OSError:
        return []


def events_lock_path(owner):
    """One event stream per session, not per invocation.

    Arming a second monitor for the same session does not double the
    information, it doubles every notification and gives the two copies
    separate memories of what they already reported, so they disagree about
    what is new. Two of them ran unnoticed from 2026-08-23 to 2026-08-25.

    Keyed by OWNER, not by machine: two Claude sessions legitimately each want
    their own stream, filtered to their own runs. A shell with no session
    identity shares one lock under "anon".
    """
    return ROOT / f"events-{owner or 'anon'}.lock"


_events_lock_socket = None


def events_lock_name(owner):
    """The kernel-held name for one session's stream.

    A leading NUL puts this in Linux's abstract socket namespace, which has no
    filesystem entry at all. That is the point: every disk-based lock I tried
    could be defeated by deleting the file. A holder locks an inode, somebody
    removes the name, and the next monitor creates a fresh file, locks that
    instead, and both stream. Verified against a real flock implementation.

    Hashed rather than spelled out, for three reasons found by review:
      - Abstract names are capped at 107 bytes. An owner of 89 characters made
        bind() fail, and the caller read that failure as "somebody else holds
        it", so the FIRST monitor refused itself and no notifications arrived.
        A digest is always the same length.
      - The user id and the fleet home go into it, so two people on one host,
        or one person with two installations, do not collide on the shared
        "anon" name.
      - It cannot be made invalid by whatever a session id happens to contain.

    The namespace is per network namespace, so two containers that do not
    share one can each bind this name. They would also have to share
    CODEX_FLEET_HOME to be watching the same runs. Documented, not defended
    against: nothing inside a container can see the other one to check.
    """
    seed = f"{os.getuid()}\0{ROOT}\0{owner or 'anon'}"
    digest = hashlib.blake2b(seed.encode(), digest_size=16).hexdigest()
    return "\0codex-fleet-events-" + digest


def claim_events_lock(owner):
    """Take the stream lock, or report the monitor that already holds it.

    Three earlier versions were all racy in the same way: reading who holds the
    lock and then writing your own claim are separate steps, so any number of
    starters pass the read before the first one writes. Eight forked processes
    all won. Creating the file exclusively did not help either, because the
    file exists for a moment before the pid is written into it and starters
    that looked in that window read an empty file and took the lock.

    Binding a name has none of that. The test and the claim are one operation
    the kernel performs, and it releases the name when the process dies.

    The pid file alongside it is a breadcrumb for the refusal message and for
    anyone reading the directory. Nothing depends on it, and deleting it costs
    a helpful message rather than correctness.
    """
    global _events_lock_socket
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM | socket.SOCK_CLOEXEC)
    try:
        sock.bind(events_lock_name(owner))
    except OSError:
        sock.close()
        try:
            holder = int(events_lock_path(owner).read_text().strip())
        except (OSError, ValueError):
            holder = -1
        return holder if holder != 0 else -1
    _events_lock_socket = sock
    try:
        ROOT.mkdir(parents=True, exist_ok=True)
        events_lock_path(owner).write_text(str(os.getpid()))
    except OSError:
        pass  # the breadcrumb is optional; the lock is already held
    return None


def release_events_lock(owner):
    """Drop the lock. Exiting would do this anyway; being explicit is clearer."""
    global _events_lock_socket
    if _events_lock_socket is None:
        return
    try:
        _events_lock_socket.close()
    finally:
        _events_lock_socket = None


def script_fingerprint():
    """A digest of the script this process is running.

    Python reads the whole file at startup and never looks again, so an events
    monitor keeps running the version it loaded no matter how many times the
    tool is rewritten. One ran for two days on code that had been replaced 21
    minutes after it started, which is why it still had no session filter and
    reported every run on the machine into every session.

    The contents, not the metadata. Size and modification time miss an edit
    that keeps the same length and puts the timestamp back, and the inode
    misses it too when the file is rewritten in place. Hashing about 100 KB
    takes well under a millisecond and this runs once every two seconds.
    """
    try:
        return hashlib.blake2b(Path(__file__).read_bytes(), digest_size=16).hexdigest()
    except OSError:
        return None


EVENTS_POLL_SECONDS = 2
EVENTS_STALL_BUCKETS = (600, 1800, 3600)
EVENTS_TAIL_BYTES = 65536
# A pid whose process began this long after the turn was launched is not the
# process the turn launched: the kernel handed the number to somebody else.
EVENTS_PID_REUSE_SLACK = 60


def tail_events(path, limit=EVENTS_TAIL_BYTES):
    """The last events of a turn log, without reading a large log whole.

    The monitor needs only the end of a log (did the turn finish, is a tool
    call still open) and polls every run every two seconds.
    """
    try:
        with open(path, "rb") as fh:
            fh.seek(0, os.SEEK_END)
            size = fh.tell()
            fh.seek(max(0, size - limit))
            data = fh.read()
    except OSError:
        return []
    lines = data.decode("utf-8", errors="replace").splitlines()
    if size > limit and lines:
        lines = lines[1:]  # the first line was cut by the seek
    events = []
    for line in lines:
        line = line.strip()
        if not line:
            continue
        try:
            events.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return events


def process_started_at(pid):
    """Wall-clock start of a live process, or None where /proc cannot say."""
    try:
        with open(f"/proc/{pid}/stat", encoding="utf-8") as fh:
            stat = fh.read()
        ticks = int(stat[stat.rindex(")") + 2 :].split()[19])
        with open("/proc/stat", encoding="utf-8") as fh:
            boot = next(int(ln.split()[1]) for ln in fh if ln.startswith("btime "))
        return boot + ticks / os.sysconf("SC_CLK_TCK")
    except (OSError, ValueError, IndexError, StopIteration):
        return None


def turn_launched_at(meta):
    """When the current turn's process was launched, or None if unrecorded."""
    turn = meta.get("turns", 1)
    raw = None
    for prompt in reversed(meta.get("prompts") or []):
        if isinstance(prompt, dict) and prompt.get("turn") == turn:
            raw = prompt.get("at")
            break
    if raw is None and turn == 1:
        raw = meta.get("created_at")
    try:
        return datetime.fromisoformat(raw).timestamp() if raw else None
    except (TypeError, ValueError):
        return None


def events_status(name, meta, tail):
    """status_of, except that a live pid alone does not make a run running.

    On 2026-09-22 a re-armed monitor announced a review that had finished 32
    hours earlier as started, then stalled, then finished, and the stop hook
    demanded its result be read again. `status_of` trusts any live process
    with the recorded pid. For the monitor that is not enough, because a
    "started" line makes an orchestrator act. A run is not running when:
      - it was pruned (pruning only ever happens to a run with no process),
      - its latest turn log already ends the turn, or
      - the process holding the pid began after the turn was launched, so the
        number now belongs to an unrelated process.
    """
    st = status_of(name, meta, tail)
    if st != "running":
        return st
    dead = dict(meta, pid=None)
    if meta.get("pruned_at"):
        return status_of(name, dead, tail)
    for ev in reversed(tail):
        if ev.get("type") in ("turn.completed", "turn.failed"):
            return status_of(name, dead, tail)
    started = process_started_at(meta.get("pid"))
    launched = turn_launched_at(meta)
    if started and launched and started > launched + EVENTS_PID_REUSE_SLACK:
        return status_of(name, dead, tail)
    return st


def inflight_item(tail):
    """The tool call the agent is inside, as (key, description), or None.

    A turn whose last event opened an item and never closed it is waiting on
    that item: a long test run, a CI watch, a deliberate sleep. That is a wait,
    not a stall, and saying "stalled" at 10, 30 and 60 minutes is noise.
    """
    if not tail or tail[-1].get("type") != "item.started":
        return None
    item = tail[-1].get("item") or {}
    kind = item.get("type", "item")
    if kind == "command_execution":
        cmd = item.get("command") or item.get("cmd") or ""
        if isinstance(cmd, list):
            cmd = " ".join(cmd)
        desc = f"command: {cmd.strip()[:120]}"
    elif kind == "mcp_tool_call":
        desc = f"tool call: {item.get('server', '?')}.{item.get('tool', '?')}"
    else:
        desc = kind
    return (item.get("id") or desc, desc)


def cmd_events(args):
    """One line per fleet event, forever. The inbound half of the connection.

    Restart after the host's monitor timeout. Run/turn/stall state survives
    restarts per session and view; unanswered questions are shown again.
    Lines are flushed individually; a bad run is retried on the next poll.

    Only transitions after the baseline are reported. The baseline is the
    saved snapshot (as of its last save) on a restart, or the moment this
    monitor started on a fresh one. A run missing from the snapshot that is
    not running is reported only if it did something after the baseline; a
    turn recorded as ended is never reported as started again.
    """
    owner = current_owner()
    holder = claim_events_lock(owner)
    if holder:
        who = f"pid {holder}" if holder > 0 else "another process"
        print(f"an events monitor is already streaming for this session ({who}); "
              f"nothing armed, that one is still delivering", flush=True)
        return
    fingerprint = script_fingerprint()

    state_path = ROOT / (events_lock_name(owner)[1:] +
                         ("-all" if getattr(args, "all", False) else "") + ".json")
    baseline = time.time()
    try:
        saved_at = state_path.stat().st_mtime
        seen = json.loads(state_path.read_text())
        if not isinstance(seen, dict) or any(
            not isinstance(item, dict)
            or "status" not in item
            or not isinstance(item.get("stall", 0), (int, float))
            for item in seen.values()
        ):
            raise ValueError("invalid events state")
        restarting = True
        baseline = saved_at
    except (OSError, ValueError):
        damaged = state_path.exists()
        seen, restarting = {}, False
        if damaged:
            print("codex-fleet: damaged monitor state reset; continuing", flush=True)
    asked = set()
    first = True
    try:
        while True:
            if fingerprint and script_fingerprint() != fingerprint:
                print("codex-fleet was updated; this monitor is exiting so a fresh "
                      "one runs the new code  ->  re-arm the events Monitor", flush=True)
                return
            try:
                for name, meta in all_runs():
                    if not getattr(args, "all", False) and not owned_here(meta):
                        continue
                    try:
                        seen[name] = events_poll_run(name, meta, seen.get(name), asked,
                                                     fresh=first and not restarting,
                                                     baseline=baseline)
                    except Exception:
                        # One bad run must not stop the others being reported
                        # or the snapshot being saved; it is retried next poll.
                        continue
                first = False
                # Save during polling, not at exit: the monitor may be SIGKILLed.
                tmp = state_path.with_suffix(".tmp")
                tmp.write_text(json.dumps(seen))
                os.replace(tmp, state_path)
            except Exception:
                # A bad poll is skipped. The stream must outlive any single error.
                pass
            time.sleep(EVENTS_POLL_SECONDS)
    finally:
        release_events_lock(owner)


def events_poll_run(name, meta, prev, asked, fresh, baseline):
    """Report one run's changes since `prev` and return its new snapshot."""
    run_id = [meta.get("created_at"), meta.get("thread_id")]
    # Spawn writes thread_id shortly after launch. Filling it in
    # is not a second start of the same run.
    if prev and prev.get("run") not in (run_id, [run_id[0], None]):
        prev = None
    turn = meta.get("turns", 1)
    new_turn = prev and prev.get("turn") != turn
    latest = run_dir(name) / f"turn-{meta.get('turns', 1)}.jsonl"
    tail = tail_events(latest)
    st = events_status(name, meta, tail)
    # A turn already recorded as ended cannot start again; only a new turn
    # can. Whatever makes the pid look alive, this is not a start.
    if st == "running" and prev and not new_turn and prev.get("status") != "running":
        st = prev["status"]
    last_activity = mtime(latest, meta)
    quiet = time.time() - (last_activity or time.time())
    role = meta.get("role", "?")

    if st == "running" and (prev is None or new_turn or prev["status"] != "running"):
        verb = "running" if fresh else "started"
        print(f"{verb} {name} ({role})", flush=True)
    elif st != "running" and (
        (prev and (prev["status"] == "running" or new_turn))
        # Unknown to the snapshot and already over: report it only if it
        # did something after the baseline, i.e. it finished while no
        # monitor was watching. Older history is not news.
        or (prev is None and last_activity > baseline)
    ):
        verb = {"idle": "finished", "failed": "FAILED", "stopped": "stopped without completing"}.get(st, st)
        latest_events = read_events(latest)
        msg = last_message(latest_events, name).replace("\n", " ")[:160]
        print(
            f"{verb} {name} ({role}) {mcp_text(latest_events, meta)}: "
            f"{msg}  ->  codex-fleet result {name}",
            flush=True,
        )

    # Every question, blocking or not. A non-blocking ask is still
    # a question the agent wants answered; the status hook marks it
    # read on its first fire, so if this stream only carried
    # blocking ones the orchestrator never saw it. That happened on
    # 2026-08-22: an engineer asked whether to change a hook
    # package, got no answer, and shipped without it.
    for index, q in enumerate(all_questions(name)):
        key = (name, run_id[0], index, q.get("at"))
        if q.get("answered") or key in asked:
            continue
        asked.add(key)
        kind = "ASKING (blocking)" if q.get("blocking") else "asks"
        blocking = str(bool(q.get("blocking"))).lower()
        print(
            f"{kind} {name} [blocking={blocking}]: {q.get('text', '')}"
            f"  ->  codex-fleet tell {name} \"<answer>\"",
            flush=True,
        )

    bucket = 0
    if st == "running":
        for b in EVENTS_STALL_BUCKETS:
            if quiet >= b:
                bucket = b
    wait = (prev or {}).get("wait") if bucket else None
    if bucket and bucket > (prev or {}).get("stall", 0):
        item = inflight_item(tail)
        if unanswered_blocking(name):
            # Waiting on the orchestrator, which already has the ASKING
            # line. Quiet is expected until `tell` answers it.
            pass
        elif item:
            # Inside one long tool call: said once, with what it is
            # waiting on, and not again at 30 and 60 minutes.
            key, desc = item
            if key != wait:
                print(
                    f"waiting {name} ({role}): one {desc} has been running for "
                    f"{bucket // 60} minutes; not repeated while it runs  ->  "
                    f"codex-fleet tail {name} -n 15, or kill it",
                    flush=True,
                )
            wait = key
        else:
            print(
                f"stalled {name} ({role}): no event for {bucket // 60} minutes  ->  codex-fleet tail {name} -n 15, or kill it",
                flush=True,
            )
    return {"run": run_id, "turn": turn, "status": st, "stall": bucket, "wait": wait}


def cmd_inbox(args):
    """Show what the agents have asked.

    New questions are marked read. Blocking ones keep showing until answered,
    because an agent that is waiting does not stop waiting when you look at it.
    """
    names = args.names or [n for n, _ in all_runs()]
    found = False
    for name in names:
        msgs = read_outbox(
            name,
            mark_read=not args.peek,
            include_unanswered_blocking=True,
            include_read=getattr(args, "all", False),
        )
        for m in msgs:
            found = True
            if m.get("answered"):
                flag = "answered"
            elif m.get("blocking"):
                flag = paint("BLOCKING, unanswered", "red")
            else:
                flag = "asks"
            if getattr(args, "all", False) and m.get("read"):
                flag += ", read"
            print(f"{paint(name, 'bold')} {flag} [{m.get('at','')}]")
            print(f"  {m.get('text','')}")
            if m.get("blocking") and not m.get("answered"):
                print(f'  answer it: codex-fleet tell {name} "<answer>"')
    if not found:
        print("nothing raised")


def cmd_kill(args):
    names = args.names or [n for n, _ in all_runs()]
    for name in names:
        meta = load_meta(name)
        pid = meta.get("pid")
        if not alive(pid):
            print(f"{name}: not running")
            continue
        try:
            os.killpg(os.getpgid(pid), signal.SIGTERM)
        except (ProcessLookupError, PermissionError) as exc:
            print(f"{name}: {exc}")
            continue
        print(f"{name}: terminated (pid {pid})")


def cmd_rm(args):
    names = args.names or []
    if args.done:
        names = [n for n, m in all_runs() if not alive(m.get("pid"))]
    for name in names:
        meta = load_meta(name)
        if meta.get("worktree"):
            ok = remove_worktree(meta)
            if ok:
                print(f"{name}: worktree removed ({meta['worktree_branch']} kept)")
            else:
                print(f"{name}: worktree at {meta['worktree']} could not be removed; "
                      f"it likely holds uncommitted work")
        d = run_dir(name)
        if d.exists():
            shutil.rmtree(d)
            print(f"removed {name}")



def cmd_prune(args):
    """Collapse old runs to their conclusion instead of deleting them.

    99.4% of a run's disk is its event log. The parts worth keeping are tiny:
    the final message, the token count, and the thread id that still makes the
    run resumable. So an old run does not need to be thrown away, it needs to
    stop carrying the transcript of how it got there.

    A pruned run keeps its place in the list, still says what it concluded, and
    `say` still resumes it. It just costs about 6KB instead of 3MB.

    Never touches a running agent, or one with a worktree still on disk.
    """
    cutoff = time.time() - args.older_than * 86400
    kept = freed = touched = 0
    for name, meta in all_runs():
        if alive(meta.get("pid")):
            continue
        if meta.get("pruned_at"):
            continue
        if meta.get("worktree") and Path(meta["worktree"]).exists():
            print(f"{name}: skipped, worktree still on disk")
            continue
        d = run_dir(name)
        logs = [f for f in d.iterdir() if f.name.startswith("turn-")]
        if not logs:
            continue
        last = max((mtime(f) for f in logs), default=0.0)
        if last > cutoff:
            kept += 1
            continue

        events = all_events(name, meta)
        size = sum(f.stat().st_size for f in logs)
        if args.dry_run:
            days = (time.time() - last) / 86400
            print(f"{name}: would free {size / 1024 / 1024:.1f} MB, last active {days:.1f}d ago")
            freed += size
            touched += 1
            continue

        # Record the conclusion BEFORE removing what produced it.
        (d / "result.txt").write_text(last_message(events) or "", encoding="utf-8")
        meta["final_status"] = status_of(name, meta)
        meta["final_usage"] = usage_of(events)
        latest_events = read_events(d / f"turn-{meta.get('turns', 1)}.jsonl")
        ok, failed = mcp_health(latest_events)
        meta["final_mcp"] = {"ok": ok, "failed": failed}
        meta["last_activity"] = last
        meta["pruned_at"] = now()
        save_meta(name, meta)
        for f in logs:
            f.unlink()
        freed += size
        touched += 1
        print(f"{name}: pruned, freed {size / 1024 / 1024:.1f} MB")

    verb = "would free" if args.dry_run else "freed"
    print(f"\n{touched} run(s) {verb} {freed / 1024 / 1024:.1f} MB; "
          f"{kept} newer than {args.older_than}d left alone")
    if touched and not args.dry_run:
        print("Their results and thread ids are kept, so `say` still resumes them.")
    # Returned in BYTES. Reading the printed line back and summing it gave a
    # total built from values already rounded to one decimal megabyte, so four
    # 60 KB logs were reported as 0.4 MB when 0.23 MB went.
    return touched, freed


# How long a finished run keeps its full event log, and how long the collapsed
# run survives after that. Runs accumulate at roughly 20 a day under heavy use,
# so without a ceiling the directory grows without limit; 88 MB across 80 runs
# had built up by 2026-08-25 before any of this existed.
GC_PRUNE_DAYS = 2
GC_DELETE_DAYS = 14


def default_branch(root):
    """The branch a fleet branch is expected to have landed in.

    Reads the remote's own idea of its default first, because guessing wrong
    means comparing against a branch that does not exist and concluding that
    no work has landed.
    """
    r = subprocess.run(
        ["git", "-C", root, "symbolic-ref", "--short", "refs/remotes/origin/HEAD"],
        capture_output=True, text=True,
    )
    if r.returncode == 0 and r.stdout.strip():
        return r.stdout.strip()
    for candidate in ("main", "master"):
        r = subprocess.run(
            ["git", "-C", root, "rev-parse", "--verify", "--quiet", candidate],
            capture_output=True, text=True,
        )
        if r.returncode == 0:
            return candidate
    return None


def branch_is_landed(root, base, branch):
    """Whether everything on `branch` is already in `base`.

    Two tests, because one is not enough. Ancestry catches an ordinary merge.
    It does NOT catch a squash merge, which is what this repository uses: the
    squashed commit has different parents, so the branch is never an ancestor
    of main even when every line of it shipped. The second test compares the
    two trees directly, which is true whenever the content landed however it
    got there. Both failing means the branch still holds work of its own.
    """
    ancestry = subprocess.run(
        ["git", "-C", root, "merge-base", "--is-ancestor", branch, base],
        capture_output=True, text=True,
    )
    if ancestry.returncode == 0:
        return True
    identical = subprocess.run(
        ["git", "-C", root, "diff", "--quiet", base, branch],
        capture_output=True, text=True,
    )
    return identical.returncode == 0


# What codex-fleet itself puts into a worktree, plus the whole .env family.
# Git ignores these in most projects, so they have to be checked by hand, and
# an unmodified copy of one is not the agent's work. The family rather than
# two literal names because a review pointed out that .env.development.local
# and its relatives are just as unrecoverable and were being treated as
# disposable; one the agent CREATED has no copy to compare against, so it
# refuses the removal.
SPAWN_PLACED_DIRS = ("node_modules",)


def is_spawn_placed(top):
    return top in SPAWN_PLACED_DIRS or top == ".env" or top.startswith(".env.")


# Ignored files are copied into the run directory before the worktree goes, so
# a deletion is recoverable rather than merely reported. Bounded, because the
# reason ignored files are not simply protected is that a built worktree here
# holds 414 of them and tens of megabytes: build output is what these limits
# are meant to exclude, and anything excluded is named.
GC_ARCHIVE_BUDGET_BYTES = 5 * 1024 * 1024
GC_ARCHIVE_MAX_FILE_BYTES = 1024 * 1024
GC_ARCHIVE_MAX_FILES = 5000


def archive_ignored(worktree, paths, destination):
    """Copy ignored files into `destination` before their worktree is removed.

    Returns (archived_count, skipped_paths, truncated). A skipped path is one
    too large to be worth keeping, which in practice means build output. The
    caller prints those, so nothing disappears without a line naming it.
    """
    candidates, truncated = [], False
    for rel in paths:
        source = Path(worktree) / rel
        if source.is_symlink():
            continue
        if source.is_dir():
            for found in sorted(source.rglob("*")):
                if len(candidates) >= GC_ARCHIVE_MAX_FILES:
                    truncated = True
                    break
                if found.is_file() and not found.is_symlink():
                    candidates.append(found)
        elif source.is_file():
            candidates.append(source)
        if truncated:
            break

    kept, skipped, total = [], [], 0
    for found in candidates:
        try:
            size = found.stat().st_size
        except OSError:
            continue
        if size > GC_ARCHIVE_MAX_FILE_BYTES or total + size > GC_ARCHIVE_BUDGET_BYTES:
            skipped.append(str(found.relative_to(worktree)))
            continue
        kept.append(found)
        total += size

    if kept:
        try:
            with tarfile.open(destination, "w:gz") as tar:
                for found in kept:
                    tar.add(found, arcname=str(found.relative_to(worktree)))
        except OSError:
            # Failing to archive must not turn into failing to report.
            return 0, skipped + [str(f.relative_to(worktree)) for f in kept], truncated
    return len(kept), skipped, truncated


def worktree_dirt(worktree, root):
    """What removing this worktree would cost: (refusal reason, disposables).

    A refusal reason means do not remove it. The disposables are ignored files
    that WILL be destroyed, listed so the removal is never silent.

    `git status --porcelain` alone is not enough, because it says nothing about
    ignored files and `git worktree remove --force` deletes them regardless.
    Found by review on 2026-08-25 with a working reproduction.

    The split is deliberate. A project's .gitignore is its own statement that
    those files are reproducible, and after an agent runs a build a worktree
    holds hundreds of them: the main checkout here has 414. Refusing on all of
    them means no worktree is ever removed and the pile-up this exists to stop
    carries on. So ignored files are reported, not protected.

    The exception is the files spawn copies IN. Those came from outside the
    worktree, an edit to one cannot be regenerated, and losing it is silent in
    a way a deleted build directory is not.
    """
    r = subprocess.run(
        ["git", "-C", worktree, "status", "--porcelain"],
        capture_output=True, text=True,
    )
    # A repository that cannot be read is treated as dirty. Refusing to delete
    # is the safe direction when the answer is unknown.
    if r.returncode != 0:
        return "its git status could not be read", []
    if r.stdout.strip():
        return "uncommitted changes", []

    listed = subprocess.run(
        ["git", "-C", worktree, "status", "--porcelain", "--ignored"],
        capture_output=True, text=True,
    )
    if listed.returncode != 0:
        return "its ignored files could not be listed", []
    disposable = []
    for line in listed.stdout.splitlines():
        if not line.startswith("!! "):
            continue
        rel = line[3:].strip().strip('"').rstrip("/")
        top = rel.split("/")[0]
        if not is_spawn_placed(top):
            disposable.append(rel)
            continue
        if top in SPAWN_PLACED_DIRS:
            continue  # a symlink into the parent checkout, nothing of its own
        try:
            if (Path(root) / rel).read_bytes() != (Path(worktree) / rel).read_bytes():
                return f"{rel} was edited after it was copied in", []
        except OSError:
            return f"{rel} could not be compared with the copy it came from", []
    return None, disposable


def sweep_worktrees(dry_run=False):
    """Remove worktrees whose work has landed, and say why the rest were kept.

    A worktree is only removed when it has no uncommitted changes AND its
    branch adds nothing to the default branch. Anything else is reported and
    left alone, because a silently deleted worktree is lost work.
    """
    removed, refused = [], []
    for name, meta in all_runs():
        wt = meta.get("worktree")
        if not wt:
            continue
        if not Path(wt).exists():
            # The directory is gone; drop the dangling reference so this run
            # stops looking like it owns a worktree.
            if not dry_run:
                meta.pop("worktree", None)
                save_meta(name, meta)
            continue
        if alive(meta.get("pid")):
            refused.append((name, "agent still running"))
            continue
        root = meta.get("worktree_root")
        branch = meta.get("worktree_branch")
        dirt, disposable = worktree_dirt(wt, root or wt)
        if dirt:
            refused.append((name, dirt))
            continue
        base = default_branch(root) if root else None
        if not root or not branch or not base:
            refused.append((name, "cannot tell what it should have merged into"))
            continue
        if not branch_is_landed(root, base, branch):
            refused.append((name, f"branch {branch} holds work not in {base}"))
            continue
        if dry_run:
            removed.append((name, wt, disposable, 0, [], False))
            continue
        # Copy before deleting, never after. A removal that could not be
        # archived is still reported in full.
        archived, skipped, truncated = (0, [], False)
        if disposable:
            archived, skipped, truncated = archive_ignored(
                wt, disposable, run_dir(name) / "ignored-files.tar.gz"
            )
        if remove_worktree(meta):
            meta.pop("worktree", None)
            save_meta(name, meta)
            removed.append((name, wt, disposable, archived, skipped, truncated))
        else:
            refused.append((name, "git refused to remove the worktree"))
    return removed, refused


def delete_expired(delete_days, dry_run=False):
    """Delete collapsed runs once their conclusion is older than the limit.

    Only touches runs that were already pruned, so a run is never deleted
    without first having had its conclusion recorded and a full retention
    period to be read.
    """
    if delete_days <= 0:
        return [], []
    cutoff = time.time() - delete_days * 86400
    gone, failed = [], []
    for name, meta in all_runs():
        pruned_at = meta.get("pruned_at")
        if not pruned_at or alive(meta.get("pid")):
            continue
        if meta.get("worktree") and Path(meta["worktree"]).exists():
            continue
        try:
            when = datetime.fromisoformat(pruned_at).timestamp()
        except (TypeError, ValueError):
            continue
        if when > cutoff:
            continue
        if dry_run:
            gone.append(name)
            continue
        shutil.rmtree(run_dir(name), ignore_errors=True)
        # ignore_errors hides a permission or filesystem failure, so confirm
        # the directory actually went rather than reporting a delete that
        # silently did not happen.
        if not run_dir(name).exists():
            gone.append(name)
        else:
            failed.append(name)
    return gone, failed


def cmd_gc(args):
    """Collapse, delete, and sweep, on a stated schedule instead of on request.

    Pruning already existed but only ran on spawn, so a fleet that went quiet
    kept everything forever. That is the actual failure: housekeeping tied to
    activity does nothing precisely when there is no activity.
    """
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        collapsed, freed_bytes = cmd_prune(
            argparse.Namespace(older_than=args.prune_days, dry_run=args.dry_run)
        )
    deleted, failed = delete_expired(args.delete_days, dry_run=args.dry_run)
    removed, refused = sweep_worktrees(dry_run=args.dry_run)

    if args.quiet and not (collapsed or deleted or failed or removed or refused):
        return
    verb, verb2, verb3 = (
        ("would collapse", "would delete", "would remove") if args.dry_run
        else ("collapsed", "deleted", "removed")
    )
    print(f"{verb} {collapsed} run(s), {freed_bytes / 1024 / 1024:.1f} MB")
    print(f"{verb2} {len(deleted)} collapsed run(s) older than {args.delete_days:g}d"
          + (f": {', '.join(deleted)}" if deleted else ""))
    print(f"{verb3} {len(removed)} worktree(s)"
          + (f": {', '.join(entry[0] for entry in removed)}" if removed else ""))
    for name, _wt, disposable, archived, skipped, truncated in removed:
        if not disposable:
            continue
        shown = ", ".join(disposable[:4])
        rest = f" and {len(disposable) - 4} more" if len(disposable) > 4 else ""
        print(f"  {name} also took {len(disposable)} ignored path(s): {shown}{rest}")
        if archived:
            print(f"    {archived} kept in {run_dir(name) / 'ignored-files.tar.gz'}")
        if skipped:
            head = ", ".join(skipped[:3])
            more = f" and {len(skipped) - 3} more" if len(skipped) > 3 else ""
            print(f"    {len(skipped)} too large to keep, gone for good: {head}{more}")
        if truncated:
            print(f"    stopped looking after {GC_ARCHIVE_MAX_FILES} files; "
                  f"anything past that was not archived")
    for name in failed:
        print(f"  COULD NOT delete {name}: it is still on disk")
    for name, why in refused:
        print(f"  kept worktree {name}: {why}")


def auto_gc():
    """Housekeeping on spawn. A workflow you have to remember is not a workflow."""
    days = float(os.environ.get("CODEX_FLEET_PRUNE_DAYS", GC_PRUNE_DAYS))
    if days <= 0:
        return
    try:
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            cmd_gc(argparse.Namespace(
                prune_days=days,
                delete_days=float(os.environ.get("CODEX_FLEET_DELETE_DAYS", GC_DELETE_DAYS)),
                dry_run=False,
                quiet=True,
            ))
        for line in buf.getvalue().splitlines():
            if line.strip() and not line.startswith(("collapsed 0", "deleted 0", "removed 0")):
                print(f"  {line.strip()}")
    except Exception:
        # Housekeeping must never stop a spawn.
        pass


