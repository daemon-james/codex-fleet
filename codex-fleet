def cmd_serve(args):
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    from urllib.parse import urlparse, parse_qs

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def send_json(self, obj):
            body = json.dumps(obj).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            u = urlparse(self.path)
            q = parse_qs(u.query)
            try:
                if u.path == "/api/runs":
                    return self.send_json(run_rows())
                if u.path == "/api/events":
                    name = (q.get("name") or [""])[0]
                    start = int((q.get("from") or ["0"])[0])
                    verbose = (q.get("verbose") or ["0"])[0] == "1"
                    if not (run_dir(name) / "meta.json").exists():
                        return self.send_json({"total": 0, "events": [], "status": "stopped"})
                    return self.send_json(run_events(name, start, verbose))
            except Exception as exc:  # a dashboard must not die on one bad run
                return self.send_json({"error": str(exc)})
            body = SERVE_PAGE.encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

    # Bind every interface: this box is worked on from other machines on the LAN.
    try:
        srv = ThreadingHTTPServer((args.host, args.port), Handler)
    except OSError as exc:
        if exc.errno != errno.EADDRINUSE:
            raise
        # One dashboard serves every run, so a second one is almost always a
        # forgotten restart rather than a real intent. Say so in one line
        # instead of a stack trace, and say how to take the port back.
        print(
            f"a dashboard is already serving http://{lan_ip()}:{args.port}\n"
            f"  it reads the same run files, so it is already showing everything\n"
            f"  restart it (after a code change) with:\n"
            f"    kill $(pgrep -f \"^python3 .*codex-fleet serve\") "
            f"&& codex-fleet serve --port {args.port} --host {args.host}",
            file=sys.stderr,
        )
        sys.exit(0)
    print(f"codex-fleet dashboard on http://{lan_ip()}:{args.port}  (ctrl-c to stop)")
    srv.serve_forever()


def lan_ip():
    import socket

    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("10.255.255.255", 1))
        return s.getsockname()[0]
    except OSError:
        return "127.0.0.1"
    finally:
        s.close()


