      break;
    }
    const ind=/^\s*/.exec(l)[0].length;
    if(ind<indent)break;
    if(!cur)break;
    const body=indent+first[2].length+1;
    cur.push(ind>=body?l.slice(body):l.trim());i++;
  }
  const html=items.map(function(it){
    let h=md(it.join("\n").replace(/^\[([ xX])\]\s+/,function(_,c){return "\u0001"+(c===" "?"0":"1")+"\u0001 "}));
