function list(lines,i){
  const first=ITEM.exec(lines[i]);
  const indent=first[1].length,ordered=/\d/.test(first[2]),tag=ordered?"ol":"ul";
  const start=ordered?parseInt(first[2],10):1;
  const items=[];let cur=null;
  while(i<lines.length){
    const l=lines[i],mm=ITEM.exec(l);
    if(mm&&mm[1].length===indent&&/\d/.test(mm[2])===ordered){cur=[mm[3]];items.push(cur);i++;continue}
    if(mm&&mm[1].length<=indent)break;
    if(!l.trim()){
      let k=i+1;while(k<lines.length&&!lines[k].trim())k++;
      if(k<lines.length){const ind=/^\s*/.exec(lines[k])[0].length,isItem=ITEM.test(lines[k]);
