    op = sub.add_parser("models", help="list models and their effort levels")
    op.add_argument("--all", action="store_true")
    op.set_defaults(func=cmd_models)

    vp = sub.add_parser("serve", help="live web dashboard for every run")
    vp.add_argument("--port", type=int, default=8787)
    vp.add_argument("--host", default="0.0.0.0", help="bind address; LAN-reachable by default")
    mode = vp.add_mutually_exclusive_group()
    mode.add_argument("--daemon", action="store_true", help="detach and log under ~/.codex-fleet")
    mode.add_argument("--status", action="store_true", help="report the recorded dashboard")
    mode.add_argument("--stop", action="store_true", help="stop the recorded dashboard")
    vp.set_defaults(func=cmd_serve)

    args = p.parse_args()
    args.func(args)


