        return
    header = f"{'NAME':<24} {'STATUS':<9} {'ROLE':<17} {'MODEL':<15} {'EFFORT':<7} {'TURNS':<6} {'TOK(out)':<9} {'MCP':<9} {'AGE':<5} LAST"
    print(paint(header, "bold"))
    for name, meta in runs:
        st = status_of(name, meta)
        # An agent waiting on an answer looks identical to one that is thinking.
        # Say which it is, in the column the eye already goes to.
        if unanswered_blocking(name):
            st = "ASKING"
        events = all_events(name, meta)
        latest = run_dir(name) / f"turn-{meta.get('turns', 1)}.jsonl"
        latest_events = read_events(latest)
        msg = last_message(events, name).replace("\n", " ")[:60]
        colour = {"running": "green", "failed": "red", "idle": "cyan", "ASKING": "red"}.get(
            st, "dim"
        )
