def cmd_serve(args):
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    from urllib.parse import urlparse, parse_qs

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def send_json(self, obj):
            body = json.dumps(obj).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            u = urlparse(self.path)
            q = parse_qs(u.query)
            try:
                if u.path == "/api/runs":
                    return self.send_json(run_rows())
                if u.path == "/api/events":
                    name = (q.get("name") or [""])[0]
                    start = int((q.get("from") or ["0"])[0])
                    verbose = (q.get("verbose") or ["0"])[0] == "1"
                    if not (run_dir(name) / "meta.json").exists():
                        return self.send_json({"total": 0, "events": [], "status": "stopped"})
                    return self.send_json(run_events(name, start, verbose))
            except Exception as exc:  # a dashboard must not die on one bad run
                return self.send_json({"error": str(exc)})
            body = SERVE_PAGE.encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

    # Bind every interface: this box is worked on from other machines on the LAN.
    srv = ThreadingHTTPServer((args.host, args.port), Handler)
    print(f"codex-fleet dashboard on http://{lan_ip()}:{args.port}  (ctrl-c to stop)")
    srv.serve_forever()


def lan_ip():
    import socket

    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("10.255.255.255", 1))
        return s.getsockname()[0]
    except OSError:
        return "127.0.0.1"
    finally:
        s.close()


def main():
    p = argparse.ArgumentParser(prog="codex-fleet", description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("spawn", help="start a Codex agent in the background")
    sp.add_argument("prompt")
    sp.add_argument("--name", "-n")
    sp.add_argument(
        "--role",
        "-r",
        default="engineer",
        choices=sorted(ROLES),
        help="engineer=gpt-5.6-sol (build/debug), reviewer=gpt-5.6-terra (review/critique)",
    )
    sp.add_argument(
        "--effort", "-e", default="high", choices=EFFORTS,
        help="high for ordinary work, xhigh for complex or high-risk work",
    )
    sp.add_argument("--sandbox", "-s", default="workspace-write", choices=SANDBOXES)
    sp.add_argument("--cd", "-C", default=".")
    sp.add_argument(
        "--worktree", "-w", action="store_true",
        help="run in a dedicated git worktree on branch fleet/<name>. Use whenever "
             "two or more writers run at once: git enforces the split, a brief does not",
    )
    sp.add_argument("--config", "-c", action="append", help="extra -c key=value passed to codex")
    sp.add_argument("--output-schema", help="JSON Schema file for the final response")
    sp.add_argument("--force", action="store_true", help="reuse the name, wiping prior state")
    sp.add_argument("--follow", "-f", action="store_true")
    sp.add_argument("--verbose", "-v", action="store_true")
    sp.add_argument("--wait-id", type=float, default=60.0)
    sp.add_argument("--no-prune", action="store_true",
                    help="skip the automatic prune of runs older than "
                         "CODEX_FLEET_PRUNE_DAYS (default 3; 0 disables)")
    sp.set_defaults(func=cmd_spawn)

    lp = sub.add_parser("list", help="show every run and its status")
    lp.set_defaults(func=cmd_list)

    wp = sub.add_parser("watch", help="stream one agent's events until its turn ends")
    wp.add_argument("name")
    wp.add_argument("--verbose", "-v", action="store_true", help="reasoning and command output")
    wp.add_argument("--raw", action="store_true")
    wp.set_defaults(func=cmd_watch, since=0)

    tp = sub.add_parser("tail", help="print the last N events without following")
    tp.add_argument("name")
    tp.add_argument("-n", type=int, default=30)
    tp.add_argument("--all", action="store_true", help="across all turns")
    tp.add_argument("--verbose", "-v", action="store_true")
    tp.add_argument("--raw", action="store_true")
    tp.set_defaults(func=cmd_tail)

    rp = sub.add_parser("result", help="print the agent's latest message")
    rp.add_argument("name")
    rp.add_argument("--all", action="store_true", help="search earlier turns too")
    rp.set_defaults(func=cmd_result)

    yp = sub.add_parser("say", help="send a follow-up into an idle agent's session")
    yp.add_argument("name")
    yp.add_argument("prompt")
    yp.add_argument("--effort", "-e", choices=EFFORTS)
    yp.add_argument("--follow", "-f", action="store_true")
    yp.add_argument("--verbose", "-v", action="store_true")
    yp.set_defaults(func=cmd_say)

    ap = sub.add_parser("wait", help="block until the FIRST named run finishes")
    ap.add_argument("names", nargs="*")
    ap.add_argument("--timeout", type=float, default=0)
    ap.add_argument("--all", action="store_true",
                    help="wait for every named run instead of returning on the first")
    ap.set_defaults(func=cmd_wait)

    tlp = sub.add_parser("tell", help="push a message into a RUNNING agent's turn")
    tlp.add_argument("name")
    tlp.add_argument("message")
    tlp.set_defaults(func=cmd_tell)

    akp = sub.add_parser("ask", help="[run BY the agent] raise a question without ending the turn")
    akp.add_argument("message")
    akp.add_argument("--name", help="defaults to $CODEX_FLEET_RUN")
    akp.add_argument("--blocking", action="store_true", help="the work cannot finish without an answer")
    akp.set_defaults(func=cmd_ask)

    ibp = sub.add_parser("inbox", help="show questions agents have raised")
    ibp.add_argument("names", nargs="*")
    ibp.add_argument("--peek", action="store_true", help="do not mark them read")
    ibp.set_defaults(func=cmd_inbox)

    pp = sub.add_parser("prune", help="collapse old runs to their result, keeping them resumable")
    pp.add_argument("--older-than", type=float, default=3, metavar="DAYS",
                    help="prune runs whose last activity is older than this (default 3)")
    pp.add_argument("--dry-run", action="store_true", help="show what would go, change nothing")
    pp.set_defaults(func=cmd_prune)

    kp = sub.add_parser("kill", help="terminate running agents")
    kp.add_argument("names", nargs="*")
    kp.set_defaults(func=cmd_kill)

    mp = sub.add_parser("rm", help="delete run state")
    mp.add_argument("names", nargs="*")
    mp.add_argument("--done", action="store_true", help="every run that is not running")
    mp.set_defaults(func=cmd_rm)

    op = sub.add_parser("models", help="list models and their effort levels")
    op.add_argument("--all", action="store_true")
    op.set_defaults(func=cmd_models)

    vp = sub.add_parser("serve", help="live web dashboard for every run")
    vp.add_argument("--port", type=int, default=8787)
    vp.add_argument("--host", default="0.0.0.0", help="bind address; LAN-reachable by default")
    vp.set_defaults(func=cmd_serve)

    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
