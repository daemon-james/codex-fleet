/* ---- markdown: enough for what an agent writes, nothing more ---- */
function inline(s){
  const code=[];
  s=esc(s).replace(/`([^`]+)`/g,function(_,c){code.push(c);return "\u0000"+(code.length-1)+"\u0000"});
  s=s.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g,function(_,t,u){
