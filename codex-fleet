def _read_serve_pid():
    try:
        info = json.loads((ROOT / "serve.pid").read_text(encoding="utf-8"))
        return {
            "pid": int(info["pid"]),
            "host": str(info["host"]),
            "port": int(info["port"]),
        }
    except (OSError, ValueError, TypeError, KeyError, json.JSONDecodeError):
        return None


def dashboard_info():
    """The recorded server is useful only while its process and port are live."""
    info = _read_serve_pid()
    if not info or not alive(info["pid"]):
        return None
    host = info["host"]
    probe = "127.0.0.1" if host == "0.0.0.0" else "::1" if host == "::" else host
    try:
        with socket.create_connection((probe, info["port"]), timeout=0.2):
            return info
    except OSError:
        return None


def _remove_serve_pid(pid=None):
    info = _read_serve_pid()
    if pid is not None and info and info["pid"] != pid:
        return
    try:
        (ROOT / "serve.pid").unlink()
    except OSError:
        pass


def _daemonize():
    """Double-fork and leave the caller only after the dashboard is reachable."""
    ROOT.mkdir(parents=True, exist_ok=True)
    child = os.fork()
    if child:
        os.waitpid(child, 0)
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline:
            info = dashboard_info()
            if info:
                print(f"dashboard started: pid={info['pid']} port={info['port']}")
                return True
            time.sleep(0.05)
        die(f"dashboard did not start; see {ROOT / 'serve.log'}")
    os.setsid()
    if os.fork():
        os._exit(0)
    null = os.open(os.devnull, os.O_RDONLY)
    log = os.open(ROOT / "serve.log", os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    os.dup2(null, 0)
    os.dup2(log, 1)
    os.dup2(log, 2)
    os.close(null)
    os.close(log)
    return False


def cmd_serve(args):
    import base64
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    from urllib.parse import urlparse, parse_qs

    if getattr(args, "status", False):
        info = dashboard_info()
        if info:
            print(f"dashboard: http://{info['host']}:{info['port']} pid={info['pid']} port={info['port']}")
        else:
            print("dashboard: not running")
        return
    if getattr(args, "stop", False):
        info = dashboard_info()
        if not info:
            _remove_serve_pid()
            print("dashboard: not running")
            return
        try:
            os.kill(info["pid"], signal.SIGTERM)
        except ProcessLookupError:
            pass
        _remove_serve_pid(info["pid"])
        print(f"dashboard stopped: pid={info['pid']}")
        return
    if getattr(args, "daemon", False):
        info = dashboard_info()
        if info:
            print(f"dashboard already running: pid={info['pid']} port={info['port']}")
            return
        if _daemonize():
            return

    allowance = SubscriptionAllowance()
    logs = TurnLogReader()

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def send_json(self, obj):
            body = json.dumps(obj).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            u = urlparse(self.path)
            q = parse_qs(u.query)
            if u.path in ("/favicon.svg", "/favicon.ico", "/apple-touch-icon.png"):
                svg = u.path == "/favicon.svg"
                body = SERVE_ICON_SVG.encode() if svg else base64.b64decode(SERVE_ICON_PNG)
                self.send_response(200)
                self.send_header("Content-Type", "image/svg+xml" if svg else "image/png")
                self.send_header("Content-Length", str(len(body)))
                self.send_header("Cache-Control", "public, max-age=86400")
                self.end_headers()
                self.wfile.write(body)
                return
            try:
                if u.path == "/api/allowance":
                    return self.send_json(allowance.read())
                if u.path == "/api/runs":
                    return self.send_json(run_rows(logs))
                if u.path == "/api/events":
                    name = (q.get("name") or [""])[0]
                    start = int((q.get("from") or ["0"])[0])
                    verbose = (q.get("verbose") or ["0"])[0] == "1"
                    if not (run_dir(name) / "meta.json").exists():
                        return self.send_json({"total": 0, "events": [], "status": "stopped"})
                    return self.send_json(run_events(name, start, verbose, logs))
            except Exception as exc:  # a dashboard must not die on one bad run
                return self.send_json({"error": str(exc)})
            body = SERVE_PAGE.encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

    # Bind every interface: this box is worked on from other machines on the LAN.
    try:
        srv = ThreadingHTTPServer((args.host, args.port), Handler)
    except OSError as exc:
        if exc.errno != errno.EADDRINUSE:
            raise
        # One dashboard serves every run, so a second one is almost always a
        # forgotten restart rather than a real intent. Say so in one line
        # instead of a stack trace, and say how to take the port back.
        print(
            f"a dashboard is already serving http://{lan_ip()}:{args.port}\n"
            f"  it reads the same run files, so it is already showing everything\n"
            f"  restart it (after a code change) with:\n"
            f"    kill $(pgrep -f \"^python3 .*codex-fleet serve\") "
            f"&& codex-fleet serve --port {args.port} --host {args.host}",
            file=sys.stderr,
        )
        sys.exit(0)
    ROOT.mkdir(parents=True, exist_ok=True)
    (ROOT / "serve.pid").write_text(
        json.dumps({"pid": os.getpid(), "host": args.host, "port": args.port}),
        encoding="utf-8",
    )
    print(f"codex-fleet dashboard on http://{lan_ip()}:{args.port}  (ctrl-c to stop)")
    try:
        srv.serve_forever()
    finally:
        _remove_serve_pid(os.getpid())


def lan_ip():
    import socket

    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("10.255.255.255", 1))
        return s.getsockname()[0]
    except OSError:
        return "127.0.0.1"
    finally:
        s.close()


