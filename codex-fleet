ANSI_RE = re.compile(r"\033\[[0-9;]*m")


def plain(text):
    return ANSI_RE.sub("", text) if text else text


def event_kind(ev):
    """A stable class name for the browser to colour by."""
    t = ev.get("type")
    if t in ("turn.failed", "error"):
        return "fail"
    if t in ("thread.started", "turn.started", "turn.completed"):
        return "meta"
    item = ev.get("item") or {}
    kind = item.get("type", "")
    if t != "item.completed" and kind == "command_execution":
        return "cmd-start"
    if kind == "agent_message":
        return "msg"
    if kind == "reasoning":
        return "think"
    if kind == "command_execution":
        return "cmd"
    if kind == "file_change":
        return "file"
    if kind == "error":
        return "fail"
    if kind in ("mcp_tool_call", "web_search"):
        return "tool"
    if kind == "todo_list":
        return "todo"
    return "meta"


def run_rows():
    rows = []
    for name, meta in all_runs():
        events = all_events(name, meta)
        usage = usage_of(events, meta)
        rows.append(
            {
                "name": name,
                "status": status_of(name, meta),
                "role": meta.get("role", "?"),
                "model": meta.get("model", "?"),
                "effort": meta.get("effort", "?"),
                "sandbox": meta.get("sandbox", "?"),
                "cwd": meta.get("cwd", ""),
                "turns": meta.get("turns", 0),
                "out": usage["output_tokens"],
                # Estimated tokens for the turn still in flight, 0 when settled.
                # The dashboard adds it and marks the total with a ~.
                "out_pending": inflight_output_estimate(events),
                "age": age(run_dir(name) / f"turn-{meta.get('turns', 1)}.jsonl", meta),
                "ts": mtime(run_dir(name) / f"turn-{meta.get('turns', 1)}.jsonl", meta),
                "last": plain(last_message(events, name))[:160],
            }
        )
    return rows  # all_runs() already ordered by most recent activity


def run_events(name, start, verbose):
    meta = load_meta(name)
    events = all_events(name, meta)
    out = []
    for i, ev in enumerate(events):
        if i < start:
            continue
        line = describe(ev, verbose=verbose)
        if line is None:
            continue
        out.append({"i": i, "kind": event_kind(ev), "text": plain(line)})
    return {"total": len(events), "events": out, "status": status_of(name, meta)}


