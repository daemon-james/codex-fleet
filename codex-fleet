#!/usr/bin/env python3
"""codex-fleet — spawn, watch, and talk to Codex agents running in parallel.

State lives in ~/.codex-fleet/runs/<name>/
  meta.json      run metadata (model, effort, cwd, thread_id, pid, turns)
  turn-N.jsonl   raw event stream for turn N
  turn-N.err     stderr for turn N
"""

import argparse
import contextlib
import io
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(os.environ.get("CODEX_FLEET_HOME", Path.home() / ".codex-fleet"))
RUNS = ROOT / "runs"

# Deliberately narrow. Role picks the model; nothing else is orchestrated here.
#   engineer -> gpt-5.6-sol    (writing, refactoring, debugging, investigation)
#   reviewer -> gpt-5.6-terra  (code review, critique, verification)
ROLES = {"engineer": "gpt-5.6-sol", "reviewer": "gpt-5.6-terra"}
MODELS = list(ROLES.values())
# high for ordinary work, xhigh for complex or high-risk work.
EFFORTS = ["high", "xhigh"]
SANDBOXES = ["read-only", "workspace-write", "danger-full-access"]

C = {
    "dim": "\033[2m",
    "red": "\033[31m",
    "green": "\033[32m",
    "yellow": "\033[33m",
    "blue": "\033[34m",
    "cyan": "\033[36m",
    "bold": "\033[1m",
    "off": "\033[0m",
}


def paint(text, *styles):
    if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
        return text
    return "".join(C[s] for s in styles) + text + C["off"]


def die(msg, code=1):
    print(f"codex-fleet: {msg}", file=sys.stderr)
    sys.exit(code)


def now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def slug(text):
    s = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return s[:40] or "run"


def run_dir(name):
    return RUNS / name


def load_meta(name):
    path = run_dir(name) / "meta.json"
    if not path.exists():
        die(f"no run named {name!r} (try: codex-fleet list)")
    return json.loads(path.read_text())


def save_meta(name, meta):
    (run_dir(name) / "meta.json").write_text(json.dumps(meta, indent=2))


def all_runs():
    """Recent first, and STABLE while agents work.

    Sorting purely by last-event time looks right and reads terribly: a live
    agent rewrites its log every second, so two running agents swap places
    continuously and the list you are trying to read jumps under you.

    So the key has to stop moving. Running agents sit at the top ordered by when
    they STARTED, which never changes for the life of the run. Everything else
    sorts by last activity, which is also fixed once the process has exited.
    Recent work stays near the top and nothing moves unless a run actually
    changes state.
    """
    if not RUNS.exists():
        return []
    out = []
    for d in RUNS.iterdir():
        meta_path = d / "meta.json"
        if meta_path.exists():
            try:
                out.append((d.name, json.loads(meta_path.read_text())))
            except json.JSONDecodeError:
                continue

    def key(pair):
        name, meta = pair
        running = alive(meta.get("pid"))
        if running:
            # Newest run first, by start time. Fixed for the whole run.
            return (0, -started_at(meta))
        # Fixed once the process exits.
        return (1, -mtime(run_dir(name) / f"turn-{meta.get('turns', 1)}.jsonl", meta))

    out.sort(key=key)
    return out


def started_at(meta):
    """Run start as a sortable number. Unparsable timestamps sort last."""
    raw = meta.get("created_at")
    if not raw:
        return 0.0
    try:
        return datetime.fromisoformat(raw).timestamp()
    except (ValueError, TypeError):
        return 0.0


def alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except (ProcessLookupError, PermissionError):
        return False
    return True


def turn_files(name, meta):
    d = run_dir(name)
    return [d / f"turn-{i}.jsonl" for i in range(1, meta.get("turns", 0) + 1)]


def read_events(path):
    if not path.exists():
        return []
    events = []
    for line in path.read_text(errors="replace").splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            events.append(json.loads(line))
        except json.JSONDecodeError:
            events.append({"type": "_unparsed", "raw": line})
    return events


def all_events(name, meta):
    events = []
    for path in turn_files(name, meta):
        events.extend(read_events(path))
    return events


def status_of(name, meta):
    if alive(meta.get("pid")):
        return "running"
    # A pruned run has no event log left. Its outcome was recorded before the
    # log went, so read that rather than guessing "stopped" from an empty file.
    if meta.get("pruned_at"):
        return meta.get("final_status", "idle")
    events = read_events(run_dir(name) / f"turn-{meta.get('turns', 1)}.jsonl")
    for ev in reversed(events):
        t = ev.get("type")
        if t == "turn.completed":
            return "idle"
        if t in ("turn.failed", "error"):
            return "failed"
    err = run_dir(name) / f"turn-{meta.get('turns', 1)}.err"
    if err.exists() and err.stat().st_size > 0 and not events:
        return "failed"
    return "stopped"


def last_message(events, name=None):
    for ev in reversed(events):
        item = ev.get("item") or {}
        if item.get("type") == "agent_message":
            return item.get("text", "")
    if name:
        # Pruned: the conclusion outlived the log that produced it.
        try:
            return (run_dir(name) / "result.txt").read_text(encoding="utf-8")
        except OSError:
            return ""
    return ""


def usage_of(events, meta=None):
    total = {"input_tokens": 0, "cached_input_tokens": 0, "output_tokens": 0}
    for ev in events:
        if ev.get("type") == "turn.completed":
            u = ev.get("usage") or {}
            for k in total:
                total[k] += u.get(k, 0) or 0
    if meta and meta.get("pruned_at") and not any(total.values()):
        return dict(total, **(meta.get("final_usage") or {}))
    return total



def mtime(path, meta=None):
    """Last activity as a sortable number. Missing files sort last, not first.

    A pruned run has no file, so it falls back to the activity time recorded
    when its log was collapsed. Without that it would sort to the bottom
    forever, which is the opposite of what pruning is for.
    """
    try:
        return path.stat().st_mtime
    except OSError:
        if meta and meta.get("last_activity"):
            return float(meta["last_activity"])
        return 0.0


def age(path, meta=None):
    stamp = mtime(path, meta)
    if not stamp:
        return "-"
    delta = time.time() - stamp
    if delta < 60:
        return f"{int(delta)}s"
    if delta < 3600:
        return f"{int(delta / 60)}m"
    return f"{int(delta / 3600)}h"


# ---------------------------------------------------------------- rendering


def describe(ev, verbose=False):
    """One line per event. Unknown item types degrade to their JSON."""
    t = ev.get("type")
    if t == "thread.started":
        return paint(f"· thread {ev.get('thread_id')}", "dim")
    if t == "turn.started":
        return paint("· turn started", "dim")
    if t == "turn.completed":
        u = ev.get("usage") or {}
        return paint(
            f"· turn completed  in={u.get('input_tokens', 0)} "
            f"cached={u.get('cached_input_tokens', 0)} out={u.get('output_tokens', 0)}",
            "dim",
        )
    if t == "turn.failed":
        return paint(f"✗ turn failed: {json.dumps(ev.get('error', ev))[:400]}", "red")
    if t == "_unparsed":
        return paint(ev["raw"][:400], "dim")
    if t not in ("item.completed", "item.started", "item.updated"):
        return paint(f"· {t} {json.dumps(ev)[:200]}", "dim")

    item = ev.get("item") or {}
    kind = item.get("type", "?")
    if t != "item.completed":
        # in-flight notice, so a live watcher sees work before it finishes
        if kind == "command_execution":
            cmd = item.get("command") or item.get("cmd") or ""
            if isinstance(cmd, list):
                cmd = " ".join(cmd)
            return paint(f"→ {cmd.strip()[:200]}", "dim")
        return None

    if kind == "agent_message":
        text = item.get("text", "").strip()
        return paint("▸ ", "green") + text
    if kind == "reasoning":
        text = (item.get("text") or item.get("summary") or "").strip()
        if not verbose:
            text = text.split("\n")[0][:160]
        return paint(f"~ {text}", "dim")
    if kind == "command_execution":
        cmd = item.get("command") or item.get("cmd") or ""
        if isinstance(cmd, list):
            cmd = " ".join(cmd)
        exit_code = item.get("exit_code")
        mark = "$" if exit_code in (0, None) else f"$[{exit_code}]"
        line = paint(f"{mark} {cmd.strip()[:300]}", "cyan")
        out = (item.get("aggregated_output") or "").strip()
        if verbose and out:
            body = "\n".join("    " + l for l in out.splitlines()[:40])
            line += "\n" + paint(body, "dim")
        return line
    if kind == "file_change":
        changes = item.get("changes") or []
        parts = []
        for ch in changes:
            if isinstance(ch, dict):
                parts.append(f"{ch.get('kind', 'edit')} {ch.get('path', '?')}")
            else:
                parts.append(str(ch))
        return paint("± " + ", ".join(parts)[:300], "yellow")
    if kind == "todo_list":
        items = item.get("items") or []
        parts = []
        for it in items:
            if isinstance(it, dict):
                box = "x" if it.get("completed") else " "
                parts.append(f"[{box}] {it.get('text', '')}")
            else:
                parts.append(str(it))
        return paint("☑ " + " | ".join(parts)[:300], "blue")
    if kind == "mcp_tool_call":
        return paint(
            f"⚙ {item.get('server', '?')}.{item.get('tool', '?')}", "cyan"
        )
    if kind == "web_search":
        return paint(f"⌕ {item.get('query', '')}", "cyan")
    if kind == "error":
        msg = item.get("message", json.dumps(item))
        if "Skill descriptions were shortened" in msg:
            return paint("· skill descriptions shortened (Codex notice)", "dim")
        return paint(f"✗ {msg[:400]}", "red")
    return paint(f"· {kind} {json.dumps(item)[:200]}", "dim")


# ---------------------------------------------------------------- commands


def build_cmd(meta, prompt, resume_id=None):
    """`codex exec resume` accepts neither -s nor -C, so those move into -c overrides.

    MCP access is why `workspace-write` becomes `--approve-for-me`. Under a plain
    `-s` sandbox every MCP tool call dies with "MCP tool call requires approval,
    but approval policy is never": the tools are listed and the network is fine,
    but nothing can approve the call in a non-interactive run. An agent that
    cannot reach Mnemonik cannot search project memory, cannot checkpoint, and
    cannot close the task it just finished. Three did exactly that on 2026-08-21.

    `--approve-for-me` routes those approvals through automatic review and is
    genuinely confined: verified 2026-08-21 that a write into a sibling repo
    fails with "Read-only file system" while writes under `-C` succeed. It
    refuses to combine with `-s`, hence the branch.

    read-only keeps no MCP, and under it the agent cannot write anywhere, so
    `codex-fleet ask` cannot reach the outbox either. That is a real cost: on
    2026-08-21 a reviewer found two criticals and could neither checkpoint them
    nor raise them mid-turn. Prefer `-s workspace-write --worktree` for review
    work. The throwaway worktree is the isolation, and `-C` confines writes to
    it, so the reviewer still cannot touch what it reviews.
    """
    cmd = ["codex", "exec"]
    if resume_id:
        cmd += ["resume", resume_id]
    cmd += ["--json", "-m", meta["model"], "-c", f"model_reasoning_effort={meta['effort']}"]
    if resume_id:
        cmd += ["-c", f'sandbox_mode="{meta["sandbox"]}"']
    elif meta["sandbox"] == "workspace-write":
        cmd += ["--approve-for-me", "-C", meta["cwd"]]
    else:
        cmd += ["-s", meta["sandbox"], "-C", meta["cwd"]]
    # The run directory is the agent's only way to speak back mid-turn. Without
    # it, an agent that hits a blocker must burn the rest of its turn and tell
    # you at the end, when the answer is worth nothing.
    #
    # `codex exec resume` rejects --add-dir the same way it rejects -s and -C,
    # so the resume path sets the same thing through config. Getting this wrong
    # is silent until someone calls `say`, and then the whole turn dies with
    # "unexpected argument '--add-dir' found".
    run_path = meta.get("run_dir")
    if run_path:
        if resume_id:
            roots = json.dumps([run_path, meta["cwd"]])
            cmd += ["-c", f"sandbox_workspace_write.writable_roots={roots}"]
        else:
            cmd += ["--add-dir", run_path]
    cmd += ["--skip-git-repo-check"]
    for extra in meta.get("config", []):
        cmd += ["-c", extra]
    if meta.get("output_schema"):
        cmd += ["--output-schema", meta["output_schema"]]
    cmd.append(prompt)
    return cmd


def launch(name, meta, prompt, resume_id=None):
    d = run_dir(name)
    turn = meta.get("turns", 0) + 1
    out = open(d / f"turn-{turn}.jsonl", "wb")
    err = open(d / f"turn-{turn}.err", "wb")
    cmd = build_cmd(meta, prompt, resume_id)
    # The inbox hook reads CODEX_FLEET_RUN to find this run's mailbox. Without
    # it the hook stays silent, which is also what every interactive Codex
    # session on this machine wants.
    child_env = dict(os.environ, CODEX_FLEET_RUN=name)
    proc = subprocess.Popen(
        cmd,
        stdin=subprocess.DEVNULL,
        stdout=out,
        stderr=err,
        cwd=meta["cwd"],
        env=child_env,
        start_new_session=True,
    )
    meta["pid"] = proc.pid
    meta["turns"] = turn
    meta.setdefault("prompts", []).append({"turn": turn, "at": now(), "text": prompt})
    save_meta(name, meta)
    return proc, d / f"turn-{turn}.jsonl"


def await_thread_id(events_path, timeout=60.0):
    deadline = time.time() + timeout
    while time.time() < deadline:
        for ev in read_events(events_path):
            if ev.get("type") == "thread.started":
                return ev.get("thread_id")
        time.sleep(0.25)
    return None



def git_root(path):
    r = subprocess.run(
        ["git", "-C", str(path), "rev-parse", "--show-toplevel"],
        capture_output=True, text=True,
    )
    return r.stdout.strip() if r.returncode == 0 else None


def make_worktree(name, base_cwd):
    """Give one agent its own checkout so concurrent writers cannot collide.

    Two agents in one tree collide; the only question is whether you notice.
    Isolation belongs to git, not to a paragraph in a brief.

    A fresh worktree has no node_modules, no .env, and no built dist. A
    read-only agent needs none of that. A writer that must RUN tests does, so
    this links node_modules and copies .env when they exist, which covers the
    common case without a full install.
    """
    root = git_root(base_cwd)
    if not root:
        die(f"--worktree needs a git repository; {base_cwd} is not in one")
    wt = Path.home() / ".codex-fleet" / "worktrees" / name
    if wt.exists():
        die(f"worktree already exists at {wt}; pick another name or codex-fleet rm {name}")
    wt.parent.mkdir(parents=True, exist_ok=True)
    branch = f"fleet/{name}"
    r = subprocess.run(
        ["git", "-C", root, "worktree", "add", "-b", branch, str(wt), "HEAD"],
        capture_output=True, text=True,
    )
    if r.returncode != 0:
        die(f"git worktree add failed: {r.stderr.strip()}")

    # Link, do not copy: node_modules is large and the agent only reads it.
    src_modules = Path(root) / "node_modules"
    if src_modules.is_dir() and not (wt / "node_modules").exists():
        try:
            os.symlink(src_modules, wt / "node_modules")
        except OSError:
            pass
    for f in (".env", ".env.local"):
        src = Path(root) / f
        if src.is_file() and not (wt / f).exists():
            try:
                shutil.copy2(src, wt / f)
                os.chmod(wt / f, 0o600)
            except OSError:
                pass
    return str(wt), branch, root


def remove_worktree(meta):
    wt = meta.get("worktree")
    root = meta.get("worktree_root")
    if not wt or not root:
        return None
    # node_modules is a symlink into the main checkout. Remove the link first so
    # nothing walks it and deletes the real one.
    link = Path(wt) / "node_modules"
    if link.is_symlink():
        try:
            link.unlink()
        except OSError:
            pass
    r = subprocess.run(
        ["git", "-C", root, "worktree", "remove", "--force", wt],
        capture_output=True, text=True,
    )
    return r.returncode == 0


def cmd_spawn(args):
    if not shutil.which("codex"):
        die("codex CLI not found on PATH")
    name = args.name or slug(args.prompt)
    if run_dir(name).exists() and not args.force:
        n = 2
        while run_dir(f"{name}-{n}").exists():
            n += 1
        name = f"{name}-{n}"
    d = run_dir(name)
    if args.force and d.exists():
        shutil.rmtree(d)
    d.mkdir(parents=True, exist_ok=True)
    work_cwd = str(Path(args.cd).resolve())
    worktree = worktree_branch = worktree_root = None
    if getattr(args, "worktree", False):
        worktree, worktree_branch, worktree_root = make_worktree(name, work_cwd)
        work_cwd = worktree
    meta = {
        "name": name,
        "role": args.role,
        "model": ROLES[args.role],
        "effort": args.effort,
        "sandbox": args.sandbox,
        "cwd": work_cwd,
        "run_dir": str(d.resolve()),
        "worktree": worktree,
        "worktree_branch": worktree_branch,
        "worktree_root": worktree_root,
        "config": args.config or [],
        "output_schema": str(Path(args.output_schema).resolve()) if args.output_schema else None,
        "created_at": now(),
        "turns": 0,
        "thread_id": None,
    }
    save_meta(name, meta)
    _, events_path = launch(name, meta, args.prompt)
    thread_id = await_thread_id(events_path, timeout=args.wait_id)
    meta = load_meta(name)
    meta["thread_id"] = thread_id
    save_meta(name, meta)
    print(f"{paint(name, 'bold')}  {meta['role']}:{meta['model']}/{meta['effort']}  pid={meta['pid']}")
    print(f"  thread {thread_id or paint('(not yet reported)', 'yellow')}")
    print(f"  events {events_path}")
    if worktree:
        print(f"  worktree {worktree}  branch {worktree_branch}")
    # Spawning is the moment new disk gets allocated, so it is the right moment
    # to collapse the old. Silent unless it actually frees something, and it
    # never touches a running agent or a run with a worktree still on disk.
    if not args.no_prune:
        auto_prune()

    if args.follow:
        cmd_watch(argparse.Namespace(name=name, verbose=args.verbose, raw=False, since=0))


def auto_prune():
    """Prune quietly on spawn. A workflow you have to remember is not a workflow."""
    days = float(os.environ.get("CODEX_FLEET_PRUNE_DAYS", "3"))
    if days <= 0:
        return
    try:
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            cmd_prune(argparse.Namespace(older_than=days, dry_run=False))
        freed = [l for l in buf.getvalue().splitlines() if ": pruned," in l]
        if freed:
            total = sum(float(l.split("freed ")[1].split(" MB")[0]) for l in freed)
            print(f"  pruned {len(freed)} run(s) older than {days:g}d, freed {total:.1f} MB")
    except Exception:
        # Housekeeping must never stop a spawn.
        pass


def cmd_list(args):
    runs = all_runs()
    if not runs:
        print("no runs")
        return
    header = f"{'NAME':<24} {'STATUS':<9} {'ROLE':<9} {'MODEL':<15} {'EFFORT':<7} {'TURNS':<6} {'TOK(out)':<9} {'AGE':<5} LAST"
    print(paint(header, "bold"))
    for name, meta in runs:
        st = status_of(name, meta)
        events = all_events(name, meta)
        usage = usage_of(events, meta)
        latest = run_dir(name) / f"turn-{meta.get('turns', 1)}.jsonl"
        msg = last_message(events, name).replace("\n", " ")[:60]
        colour = {"running": "green", "failed": "red", "idle": "cyan"}.get(st, "dim")
        role = meta.get("role", "-")
        print(
            f"{name:<24} {paint(f'{st:<9}', colour)} {role:<9} {meta['model']:<15} {meta['effort']:<7} "
            f"{meta.get('turns', 0):<6} {usage['output_tokens']:<9} {age(latest, meta):<5} {msg}"
        )


def cmd_watch(args):
    meta = load_meta(args.name)
    seen = 0
    idle_since = None
    while True:
        meta = load_meta(args.name)
        path = run_dir(args.name) / f"turn-{meta.get('turns', 1)}.jsonl"
        events = read_events(path)
        for ev in events[seen:]:
            if args.raw:
                print(json.dumps(ev))
            else:
                line = describe(ev, verbose=args.verbose)
                if line is not None:
                    print(line)
        seen = len(events)
        if not alive(meta.get("pid")):
            if idle_since is None:
                idle_since = time.time()
            elif time.time() - idle_since > 1.0:
                err_path = run_dir(args.name) / f"turn-{meta.get('turns', 1)}.err"
                if not events and err_path.exists():
                    sys.stderr.write(err_path.read_text()[:2000])
                break
        else:
            idle_since = None
        time.sleep(0.4)


def cmd_tail(args):
    meta = load_meta(args.name)
    events = all_events(args.name, meta) if args.all else read_events(
        run_dir(args.name) / f"turn-{meta.get('turns', 1)}.jsonl"
    )
    for ev in events[-args.n :]:
        if args.raw:
            print(json.dumps(ev))
        else:
            line = describe(ev, verbose=args.verbose)
            if line is not None:
                print(line)


def cmd_result(args):
    """The latest turn only, so a failed turn never returns a stale earlier answer."""
    meta = load_meta(args.name)
    events = (
        all_events(args.name, meta)
        if args.all
        else read_events(run_dir(args.name) / f"turn-{meta.get('turns', 1)}.jsonl")
    )
    text = last_message(events, args.name)
    if not text:
        st = status_of(args.name, meta)
        err_path = run_dir(args.name) / f"turn-{meta.get('turns', 1)}.err"
        if err_path.exists() and err_path.stat().st_size:
            sys.stderr.write(err_path.read_text()[:2000])
        die(f"{args.name}: no agent message in turn {meta.get('turns')} (status {st})", 2)
    print(text)


def cmd_say(args):
    meta = load_meta(args.name)
    if alive(meta.get("pid")):
        die(f"{args.name} is still running — wait, or codex-fleet kill {args.name}", 2)
    if not meta.get("thread_id"):
        die(f"{args.name} has no thread id; cannot resume")
    if args.effort:
        meta["effort"] = args.effort
    _, events_path = launch(args.name, meta, args.prompt, resume_id=meta["thread_id"])
    print(f"{args.name}: turn {meta['turns']} started (pid {meta['pid']})")
    if args.follow:
        cmd_watch(argparse.Namespace(name=args.name, verbose=args.verbose, raw=False, since=0))


def cmd_wait(args):
    """Return as soon as ANY named run finishes. --all restores the barrier.

    This used to block until every named run finished, and that is the wrong
    default for a fleet. The orchestrator's only reliable wake-up is this
    command exiting, so waiting on a fast agent and a slow one together made the
    fast one's result invisible until the slow one landed. On 2026-08-21 a test
    agent sat finished for several minutes behind a longer-running engineer, and
    the owner noticed before the orchestrator did.

    A finished agent is work to do. Return, report who is still going, and let
    the caller re-wait for the rest.
    """
    names = args.names or [n for n, _ in all_runs()]
    deadline = time.time() + args.timeout if args.timeout else None
    pending = set(names)
    done = []

    def report(name, meta):
        st = status_of(name, meta)
        colour = "red" if st in ("failed", "stopped") else "green"
        print(f"{name}: {paint(st, colour)}")
        if st in ("failed", "stopped"):
            err_path = run_dir(name) / f"turn-{meta.get('turns', 1)}.err"
            if err_path.exists() and err_path.stat().st_size:
                for line in err_path.read_text().strip().splitlines()[:6]:
                    print(paint(f"    {line}", "red"))

    while pending:
        for name in sorted(pending):
            meta = load_meta(name)
            if not alive(meta.get("pid")):
                report(name, meta)
                done.append(name)
                pending.discard(name)
        if done and not args.all:
            if pending:
                print(f"still running: {', '.join(sorted(pending))}")
                print(f"  wait again with: codex-fleet wait {' '.join(sorted(pending))}")
            return
        if pending and deadline and time.time() > deadline:
            print(f"timeout, still running: {', '.join(sorted(pending))}", file=sys.stderr)
            sys.exit(3)
        if pending:
            time.sleep(1.0)


def cmd_tell(args):
    """Push a message into a RUNNING agent's turn.

    `say` cannot do this: `codex exec` reads stdin only for the initial prompt
    and has no channel into a turn already in flight. This writes to the run's
    inbox instead, and the PostToolUse hook hands it to the agent on its next
    tool call. Delivery therefore costs one tool call, not one turn.

    Works whether or not the agent is running. A message left for an idle agent
    is delivered when it next moves.
    """
    meta = load_meta(args.name)
    if not meta:
        die(f"no run named {args.name}")
    d = run_dir(args.name)
    d.mkdir(parents=True, exist_ok=True)
    inbox = d / "inbox.jsonl"
    with open(inbox, "a", encoding="utf-8") as fh:
        fh.write(json.dumps({"text": args.message, "at": now(), "read": False}) + "\n")
    state = status_of(args.name, meta)
    where = "on its next tool call" if state == "running" else "when it next runs"
    print(f"queued for {args.name} ({state}); delivered {where}")



def cmd_ask(args):
    """Raise a question or a blocker WITHOUT ending your turn. Run by the agent.

    The counterpart to `tell`. An agent that hits a wrong brief, a missing
    decision, or a file another agent has claimed used to have one option: burn
    the rest of the turn, or stop. Now it writes here and keeps working. The
    orchestrator sees it on its next tool call and can answer with `tell`,
    which lands on the agent's next tool call.

    Reads CODEX_FLEET_RUN, so the agent never has to know its own name.
    """
    name = args.name or os.environ.get("CODEX_FLEET_RUN")
    if not name:
        die("no run name: set CODEX_FLEET_RUN, or pass one")
    d = run_dir(name)
    if not d.exists():
        die(f"no run named {name}")
    with open(d / "outbox.jsonl", "a", encoding="utf-8") as fh:
        fh.write(json.dumps({
            "text": args.message,
            "at": now(),
            "blocking": bool(args.blocking),
            "read": False,
        }) + "\n")
    if args.blocking:
        print("raised as BLOCKING. Keep working on anything that does not depend "
              "on the answer; check back for a reply on later tool calls.")
    else:
        print("raised. Keep working; a reply will reach you on a later tool call.")


def read_outbox(name, mark_read=True):
    """Unread agent questions, oldest first. Used by the orchestrator's hook."""
    path = run_dir(name) / "outbox.jsonl"
    if not path.exists():
        return []
    try:
        lines = [ln for ln in path.read_text(encoding="utf-8").splitlines() if ln.strip()]
    except OSError:
        return []
    unread, rewritten, changed = [], [], False
    for ln in lines:
        try:
            msg = json.loads(ln)
        except ValueError:
            rewritten.append(ln)
            continue
        if not msg.get("read"):
            unread.append(msg)
            if mark_read:
                msg["read"] = True
                changed = True
        rewritten.append(json.dumps(msg))
    if changed:
        try:
            tmp = path.with_suffix(".jsonl.tmp")
            tmp.write_text("\n".join(rewritten) + "\n", encoding="utf-8")
            os.replace(tmp, path)
        except OSError:
            pass
    return unread


def cmd_inbox(args):
    """Show what the agents have asked. Marks them read unless --peek."""
    names = args.names or [n for n, _ in all_runs()]
    found = False
    for name in names:
        msgs = read_outbox(name, mark_read=not args.peek)
        for m in msgs:
            found = True
            flag = paint("BLOCKING", "red") if m.get("blocking") else "asks"
            print(f"{paint(name, 'bold')} {flag} [{m.get('at','')}]")
            print(f"  {m.get('text','')}")
    if not found:
        print("nothing raised")


def cmd_kill(args):
    names = args.names or [n for n, _ in all_runs()]
    for name in names:
        meta = load_meta(name)
        pid = meta.get("pid")
        if not alive(pid):
            print(f"{name}: not running")
            continue
        try:
            os.killpg(os.getpgid(pid), signal.SIGTERM)
        except (ProcessLookupError, PermissionError) as exc:
            print(f"{name}: {exc}")
            continue
        print(f"{name}: terminated (pid {pid})")


def cmd_rm(args):
    names = args.names or []
    if args.done:
        names = [n for n, m in all_runs() if not alive(m.get("pid"))]
    for name in names:
        meta = load_meta(name)
        if meta.get("worktree"):
            ok = remove_worktree(meta)
            if ok:
                print(f"{name}: worktree removed ({meta['worktree_branch']} kept)")
            else:
                print(f"{name}: worktree at {meta['worktree']} could not be removed; "
                      f"it likely holds uncommitted work")
        d = run_dir(name)
        if d.exists():
            shutil.rmtree(d)
            print(f"removed {name}")



def cmd_prune(args):
    """Collapse old runs to their conclusion instead of deleting them.

    99.4% of a run's disk is its event log. The parts worth keeping are tiny:
    the final message, the token count, and the thread id that still makes the
    run resumable. So an old run does not need to be thrown away, it needs to
    stop carrying the transcript of how it got there.

    A pruned run keeps its place in the list, still says what it concluded, and
    `say` still resumes it. It just costs about 6KB instead of 3MB.

    Never touches a running agent, or one with a worktree still on disk.
    """
    cutoff = time.time() - args.older_than * 86400
    kept = freed = touched = 0
    for name, meta in all_runs():
        if alive(meta.get("pid")):
            continue
        if meta.get("pruned_at"):
            continue
        if meta.get("worktree") and Path(meta["worktree"]).exists():
            print(f"{name}: skipped, worktree still on disk")
            continue
        d = run_dir(name)
        logs = [f for f in d.iterdir() if f.name.startswith("turn-")]
        if not logs:
            continue
        last = max((mtime(f) for f in logs), default=0.0)
        if last > cutoff:
            kept += 1
            continue

        events = all_events(name, meta)
        size = sum(f.stat().st_size for f in logs)
        if args.dry_run:
            days = (time.time() - last) / 86400
            print(f"{name}: would free {size / 1024 / 1024:.1f} MB, last active {days:.1f}d ago")
            freed += size
            touched += 1
            continue

        # Record the conclusion BEFORE removing what produced it.
        (d / "result.txt").write_text(last_message(events) or "", encoding="utf-8")
        meta["final_status"] = status_of(name, meta)
        meta["final_usage"] = usage_of(events)
        meta["last_activity"] = last
        meta["pruned_at"] = now()
        save_meta(name, meta)
        for f in logs:
            f.unlink()
        freed += size
        touched += 1
        print(f"{name}: pruned, freed {size / 1024 / 1024:.1f} MB")

    verb = "would free" if args.dry_run else "freed"
    print(f"\n{touched} run(s) {verb} {freed / 1024 / 1024:.1f} MB; "
          f"{kept} newer than {args.older_than}d left alone")
    if touched and not args.dry_run:
        print("Their results and thread ids are kept, so `say` still resumes them.")


def cmd_models(args):
    """Only the sanctioned models and efforts, checked against the local catalog."""
    cache = Path.home() / ".codex" / "models_cache.json"
    catalog = {}
    if cache.exists():
        for m in json.loads(cache.read_text()).get("models", []):
            catalog[m["slug"]] = [e["effort"] for e in m.get("supported_reasoning_levels") or []]
    for role, slug_name in sorted(ROLES.items()):
        known = catalog.get(slug_name)
        if known is None:
            note = paint("not in local catalog", "yellow")
        else:
            missing = [e for e in EFFORTS if e not in known]
            note = paint(f"unsupported: {','.join(missing)}", "red") if missing else "ok"
        print(f"{role:<9} {slug_name:<16} efforts={','.join(EFFORTS):<12} {note}")


