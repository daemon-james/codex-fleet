    pp.set_defaults(func=cmd_prune)

    kp = sub.add_parser("kill", help="terminate running agents")
    kp.add_argument("names", nargs="*")
    kp.set_defaults(func=cmd_kill)

    mp = sub.add_parser("rm", help="delete run state")
