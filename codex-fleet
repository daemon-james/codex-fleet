    tp.add_argument("--verbose", "-v", action="store_true")
    tp.add_argument("--raw", action="store_true")
    tp.set_defaults(func=cmd_tail)

    rp = sub.add_parser("result", help="print the agent's latest message")
    rp.add_argument("name")
    rp.add_argument("--all", action="store_true", help="search earlier turns too")
    rp.set_defaults(func=cmd_result)

    yp = sub.add_parser("say", help="send a follow-up into an idle agent's session")
    yp.add_argument("name")
    yp.add_argument("prompt")
    yp.add_argument("--effort", "-e", choices=EFFORT_CHOICES,
                    help="change effort within the run's role; omitted keeps its current effort")
    yp.add_argument("--follow", "-f", action="store_true")
    yp.add_argument("--verbose", "-v", action="store_true")
    yp.set_defaults(func=cmd_say)

    ap = sub.add_parser("wait", help="block until the FIRST named run finishes")
    ap.add_argument("names", nargs="*")
    ap.add_argument("--timeout", type=float, default=0)
    ap.add_argument("--all", action="store_true",
                    help="wait for every named run instead of returning on the first")
    ap.set_defaults(func=cmd_wait)

    tlp = sub.add_parser("tell", help="push a message into a RUNNING agent's turn")
    tlp.add_argument("name")
    tlp.add_argument("message")
    tlp.set_defaults(func=cmd_tell)

    akp = sub.add_parser("ask", help="[run BY the agent] raise a question without ending the turn")
    akp.add_argument("message")
    akp.add_argument("--name", help="defaults to $CODEX_FLEET_RUN")
    akp.add_argument("--blocking", action="store_true", help="the work cannot finish without an answer")
    akp.set_defaults(func=cmd_ask)

    ev = sub.add_parser("events", help="one line per fleet event, forever; restartable stream for the session")
    ev.add_argument("--all", action="store_true", help="include runs owned by other sessions")
    ev.set_defaults(func=cmd_events)
    ibp = sub.add_parser("inbox", help="show questions agents have raised")
    ibp.add_argument("names", nargs="*")
