    if(mm&&mm[1].length===indent&&/\d/.test(mm[2])===ordered){cur=[mm[3]];items.push(cur);i++;continue}
    if(mm&&mm[1].length<=indent)break;
    if(!l.trim()){
      let k=i+1;while(k<lines.length&&!lines[k].trim())k++;
      if(k<lines.length){const ind=/^\s*/.exec(lines[k])[0].length,isItem=ITEM.test(lines[k]);
        if(ind>indent||(isItem&&ind===indent)){if(cur)cur.push("");i=k;continue}}
      break;
    }
    const ind=/^\s*/.exec(l)[0].length;
    if(ind<indent)break;
    if(!cur)break;
    const body=indent+first[2].length+1;
    cur.push(ind>=body?l.slice(body):l.trim());i++;
  }
  const html=items.map(function(it){
    let h=md(it.join("\n").replace(/^\[([ xX])\]\s+/,function(_,c){return "\u0001"+(c===" "?"0":"1")+"\u0001 "}));
    if(/^<p>[^]*<\/p>$/.test(h)&&h.indexOf("<p>",1)<0)h=h.slice(3,-4);
    h=h.replace(/\u0001([01])\u0001/g,function(_,c){return "<span class=\"chk\">"+(c==="1"?"&#9745;":"&#9744;")+"</span>"});
    return "<li>"+h+"</li>"}).join("");
  const attr=ordered&&start!==1?" start=\""+start+"\"":"";
  return {html:"<"+tag+attr+">"+html+"</"+tag+">",next:i};
}
function cells(l){return l.trim().replace(/^\|/,"").replace(/\|$/,"").split("|").map(c=>c.trim())}
function table(lines,i){
  const head=cells(lines[i]);i+=2;const rows=[];
  while(i<lines.length&&/^\s*\|/.test(lines[i])){rows.push(cells(lines[i]));i++}
  const h="<thead><tr>"+head.map(c=>"<th>"+inline(c)+"</th>").join("")+"</tr></thead>";
  const b="<tbody>"+rows.map(r=>"<tr>"+r.map(c=>"<td>"+inline(c)+"</td>").join("")+"</tr>").join("")+"</tbody>";
  return {html:"<table>"+h+b+"</table>",next:i};
}

/* ---- one event row ---- */
const LEAD=/^(▸|~|→|±|☑|⚙|⌕|✗|·|\$(\[\d+\])?)\s?/;
function row(e){
  const div=document.createElement("div");div.className="ev "+e.kind;
  let text=e.text||"",glyph="",exit="";
  const m=LEAD.exec(text);
  if(m){glyph=m[1];text=text.slice(m[0].length);
    if(m[2]){exit=m[2].slice(1,-1);glyph="$"}}
  const g=document.createElement("span");g.className="g";g.textContent=glyph;
  const t=document.createElement("div");t.className="t";
  if(e.kind==="msg"||e.kind==="think"){t.className="t md";t.innerHTML=md(text)}
  else if(e.kind==="cmd"){
    const nl=text.indexOf("\n");
    const head=nl<0?text:text.slice(0,nl);
    const sh=/^(\/bin\/(?:ba)?sh|bash|sh|zsh)\s+-l?c\s+/.exec(head);
    if(sh){const w=document.createElement("span");w.className="sh";w.textContent=sh[0];t.appendChild(w);
      t.appendChild(document.createTextNode(head.slice(sh[0].length)))}
    else t.textContent=head;
    if(nl>=0){const o=document.createElement("span");o.className="out";
      o.textContent=text.slice(nl+1).replace(/^ {4}/gm,"");t.appendChild(o)}
    if(exit){const x=document.createElement("span");x.className="x";x.textContent="exit "+exit;t.insertBefore(x,t.querySelector(".out"))}
  }
  else t.textContent=text;
  div.appendChild(g);div.appendChild(t);return div;
}

