ANSI_RE = re.compile(r"\033\[[0-9;]*m")


def plain(text):
    return ANSI_RE.sub("", text) if text else text


def event_kind(ev):
    """A stable class name for the browser to colour by."""
    t = ev.get("type")
    if t in ("turn.failed", "error"):
        return "fail"
    if t in ("thread.started", "turn.started", "turn.completed"):
        return "meta"
    item = ev.get("item") or {}
    kind = item.get("type", "")
    if t != "item.completed" and kind == "command_execution":
        return "cmd-start"
    if kind == "agent_message":
        return "msg"
    if kind == "reasoning":
        return "think"
    if kind == "command_execution":
        return "cmd"
    if kind == "file_change":
        return "file"
    if kind == "error":
        return "fail"
    if kind in ("mcp_tool_call", "web_search"):
        return "tool"
    if kind == "todo_list":
        return "todo"
    return "meta"


class TurnLogReader:
    """Cache parsed turn logs and consume only bytes appended since the last poll."""

    def __init__(self):
        self.files = {}
        self.lock = threading.Lock()
        self.bytes_read = 0

    def _read(self, path):
        try:
            size = path.stat().st_size
        except OSError:
            self.files.pop(path, None)
            return []
        state = self.files.get(path)
        if state is None or size < state["offset"]:
            state = {"offset": 0, "pending": b"", "events": []}
            self.files[path] = state
        if size == state["offset"]:
            return state["events"]
        try:
            with path.open("rb") as fh:
                fh.seek(state["offset"])
                chunk = fh.read()
        except OSError:
            return state["events"]
        state["offset"] += len(chunk)
        self.bytes_read += len(chunk)
        lines = (state["pending"] + chunk).split(b"\n")
        state["pending"] = lines.pop()
        for raw in lines:
            raw = raw.strip()
            if not raw:
                continue
            text = raw.decode("utf-8", "replace")
            try:
                state["events"].append(json.loads(text))
            except json.JSONDecodeError:
                state["events"].append({"type": "_unparsed", "raw": text})
        return state["events"]

    def read(self, path):
        with self.lock:
            return list(self._read(path))

    def all(self, name, meta):
        with self.lock:
            events = []
            for path in turn_files(name, meta):
                events.extend(self._read(path))
            return events


def run_rows(logs=None):
    rows = []
    for name, meta in all_runs():
        events = logs.all(name, meta) if logs else all_events(name, meta)
        latest = run_dir(name) / f"turn-{meta.get('turns', 1)}.jsonl"
        latest_events = logs.read(latest) if logs else None
        usage = usage_of(events, meta)
        rows.append(
            {
                "name": name,
                "status": status_of(name, meta, latest_events),
                "role": meta.get("role", "?"),
                "model": meta.get("model", "?"),
                "effort": meta.get("effort", "?"),
                "sandbox": meta.get("sandbox", "?"),
                "cwd": meta.get("cwd", ""),
                "turns": meta.get("turns", 0),
                "out": usage["output_tokens"],
                # Estimated tokens for the turn still in flight, 0 when settled.
                # The dashboard adds it and marks the total with a ~.
                "out_pending": inflight_output_estimate(events),
                "age": age(run_dir(name) / f"turn-{meta.get('turns', 1)}.jsonl", meta),
                "ts": mtime(run_dir(name) / f"turn-{meta.get('turns', 1)}.jsonl", meta),
                "last": plain(last_message(events, name))[:160],
            }
        )
    return rows  # all_runs() already ordered by most recent activity


def run_events(name, start, verbose, logs=None):
    meta = load_meta(name)
    events = logs.all(name, meta) if logs else all_events(name, meta)
    out = []
    for i, ev in enumerate(events[start:], start):
        line = describe(ev, verbose=verbose)
        if line is None:
            continue
        out.append({"i": i, "kind": event_kind(ev), "text": plain(line)})
    latest = run_dir(name) / f"turn-{meta.get('turns', 1)}.jsonl"
    latest_events = logs.read(latest) if logs else None
    return {
        "total": len(events),
        "events": out,
        "status": status_of(name, meta, latest_events),
    }


def read_subscription_limits(timeout=10):
    """Read account limits through Codex; no thread, model turn or MCP startup."""
    with subprocess.Popen(
        ["codex", "app-server", "--stdio"], stdin=subprocess.PIPE,
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    ) as proc:
        def send(message):
            proc.stdin.write((json.dumps(message) + "\n").encode())
            proc.stdin.flush()

        try:
            send({"id": 1, "method": "initialize", "params": {
                "clientInfo": {"name": "codex_fleet_usage", "version": "1.0"}}})
            deadline = time.monotonic() + timeout
            buffer = b""
            while time.monotonic() < deadline:
                ready, _, _ = select.select([proc.stdout], [], [], max(0, deadline - time.monotonic()))
                if not ready:
                    break
                chunk = os.read(proc.stdout.fileno(), 65536)
                if not chunk:
                    raise RuntimeError("Codex usage reader exited")
                buffer += chunk
                while b"\n" in buffer:
                    line, buffer = buffer.split(b"\n", 1)
                    message = json.loads(line)
                    if message.get("id") not in (1, 2):
                        continue
                    if "error" in message:
                        raise RuntimeError("Codex could not read subscription allowance")
                    if message["id"] == 1:
                        send({"method": "initialized"})
                        send({"id": 2, "method": "account/rateLimits/read"})
                    else:
                        return message["result"]
            raise TimeoutError("Codex usage read timed out")
        finally:
            proc.terminate()
            try:
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait()


def weekly_allowance(result):
    # The fleet uses the main Codex allowance, not unrelated model buckets.
    limits = (result.get("rateLimitsByLimitId") or {}).get("codex") or result.get("rateLimits") or {}
    if limits.get("limitId") not in (None, "codex"):
        return None
    for key in ("primary", "secondary"):
        window = limits.get(key) or {}
        used, minutes = window.get("usedPercent"), window.get("windowDurationMins")
        if not isinstance(used, (int, float)) or minutes != 10080:
            continue
        return max(0, min(100, 100 - used))
    return None


class SubscriptionAllowance:
    """One short read per minute across every dashboard viewer."""
    def __init__(self):
        self.lock = threading.Lock()
        self.next_read = 0
        self.snapshot = {"remaining": None, "updated_at": None, "stale": False}

    def read(self):
        with self.lock:
            if time.monotonic() < self.next_read:
                return self.snapshot
            try:
                remaining = weekly_allowance(read_subscription_limits())
                self.snapshot = {"remaining": remaining, "updated_at": time.time(), "stale": False}
            except (OSError, ValueError, RuntimeError, KeyError):
                self.snapshot = dict(self.snapshot, stale=True)
            self.next_read = time.monotonic() + 60
            return self.snapshot


